      "Output"]}, Open]], 
  Cell[CellGroupData[
    {Cell[BoxData[RowBox[{"Module", "[", 
         RowBox[{RowBox[{"{", RowBox[{"rad", ",", "ang", ",", "theta", ",", 
               "slope", ",", "curvature", ",", "field", ",", "amplitude", 
               ",", "tx", ",", "ty", ",", "txRad", ",", "tyRad", ",", 
               "txPhi", ",", "tyPhi", ",", "normal", ",", "tangent1", ",", 
               "tangent2", ",", "perturbed", ",", "radialDerivative", ",", 
               "angularDerivative", ",", "dx", ",", "dy", ",", "vectorX", 
               ",", "vectorY", ",", "atPhiZero", ",", "density", ",", 
               "expansion", ",", "zerothOrder", ",", "firstOrder", ",", 
               "secondOrder", ",", "equation9", ",", "linearDivergence", ",", 
               "normalPotential", ",", "anomalousPotential", ",", 
               "angularCoefficient", ",", "paperU", ",", "paperG", ",", 
               "paperA", ",", "gradientForm", ",", "assumptions", ",", 
               "checks"}], "}"}], ",", RowBox[{RowBox[{"normal", "=", RowBox[
                {"{", RowBox[{RowBox[{RowBox[{"-", RowBox[{"Sin", "[", 
                         "theta", "]"}]}], " ", RowBox[{"Sin", "[", "ang", 
                       "]"}]}], ",", RowBox[{RowBox[{"Sin", "[", "theta", 
                       "]"}], " ", RowBox[{"Cos", "[", "ang", "]"}]}], ",", 
                   RowBox[{"Cos", "[", "theta", "]"}]}], "}"}]}], ";", 
             RowBox[{"tangent1", "=", RowBox[{"{", RowBox[
                  {RowBox[{RowBox[{"-", RowBox[{"Cos", "[", "theta", "]"}]}], 
                     " ", RowBox[{"Sin", "[", "ang", "]"}]}], ",", 
                   RowBox[{RowBox[{"Cos", "[", "theta", "]"}], " ", 
                     RowBox[{"Cos", "[", "ang", "]"}]}], ",", RowBox[
                    {"-", RowBox[{"Sin", "[", "theta", "]"}]}]}], "}"}]}], 
             ";", RowBox[{"tangent2", "=", RowBox[{"{", RowBox[
                  {RowBox[{"-", RowBox[{"Cos", "[", "ang", "]"}]}], ",", 
                   RowBox[{"-", RowBox[{"Sin", "[", "ang", "]"}]}], ",", 
                   "0"}], "}"}]}], ";", RowBox[{"perturbed", "=", RowBox[
                {RowBox[{"normal", " ", SqrtBox[RowBox[{"1", "-", RowBox[
                       {SuperscriptBox["amplitude", "2"], " ", RowBox[
                         {"(", RowBox[{SuperscriptBox["tx", "2"], "+", 
                          SuperscriptBox["ty", "2"]}], ")"}]}]}]]}], "+", 
                 RowBox[{"amplitude", " ", RowBox[{"(", RowBox[
                      {RowBox[{"tangent1", " ", "tx"}], "+", RowBox[
                        {"tangent2", " ", "ty"}]}], ")"}]}]}]}], ";", 
             RowBox[{RowBox[{"radialDerivative", "[", "expr_", "]"}], ":=", 
               RowBox[{RowBox[{SubscriptBox["\[PartialD]", RowBox[{"rad"}]], 
                   "expr"}], "+", RowBox[{"slope", " ", RowBox[{SubscriptBox[
                      "\[PartialD]", RowBox[{"theta"}]], "expr"}]}], "+", 
                 RowBox[{"curvature", " ", RowBox[{SubscriptBox[
                      "\[PartialD]", RowBox[{"slope"}]], "expr"}]}], "+", 
                 RowBox[{"txRad", " ", RowBox[{SubscriptBox["\[PartialD]", 
                      RowBox[{"tx"}]], "expr"}]}], "+", RowBox[{"tyRad", " ", 
                   RowBox[{SubscriptBox["\[PartialD]", RowBox[{"ty"}]], 
                     "expr"}]}]}]}], ";", RowBox[{RowBox[
                {"angularDerivative", "[", "expr_", "]"}], ":=", RowBox[
                {RowBox[{SubscriptBox["\[PartialD]", RowBox[{"ang"}]], 
                   "expr"}], "+", RowBox[{"txPhi", " ", RowBox[{SubscriptBox[
                      "\[PartialD]", RowBox[{"tx"}]], "expr"}]}], "+", 
                 RowBox[{"tyPhi", " ", RowBox[{SubscriptBox["\[PartialD]", 
                      RowBox[{"ty"}]], "expr"}]}]}]}], ";", 
             RowBox[{RowBox[{"dx", "[", "expr_", "]"}], ":=", RowBox[
                {RowBox[{RowBox[{"Cos", "[", "ang", "]"}], " ", RowBox[
                    {"radialDerivative", "[", "expr", "]"}]}], "-", 
                 FractionBox[RowBox[{RowBox[{"Sin", "[", "ang", "]"}], " ", 
                    RowBox[{"angularDerivative", "[", "expr", "]"}]}], 
                  "rad"]}]}], ";", RowBox[{RowBox[{"dy", "[", "expr_", "]"}], 
               ":=", RowBox[{RowBox[{RowBox[{"Sin", "[", "ang", "]"}], " ", 
                   RowBox[{"radialDerivative", "[", "expr", "]"}]}], "+", 
                 FractionBox[RowBox[{RowBox[{"Cos", "[", "ang", "]"}], " ", 
                    RowBox[{"angularDerivative", "[", "expr", "]"}]}], 
                  "rad"]}]}], ";", RowBox[{"vectorX", "=", RowBox[
                {RowBox[{"dx", "[", "perturbed", "]"}], "/.", 
                 "\[VeryThinSpace]", RowBox[{"ang", "\[Rule]", "0"}]}]}], 
             ";", RowBox[{"vectorY", "=", RowBox[{RowBox[{"dy", "[", 
                   "perturbed", "]"}], "/.", "\[VeryThinSpace]", 
                 RowBox[{"ang", "\[Rule]", "0"}]}]}], ";", 
             RowBox[{"atPhiZero", "=", RowBox[{"perturbed", "/.", 
                 "\[VeryThinSpace]", RowBox[{"ang", "\[Rule]", "0"}]}]}], 
             ";", RowBox[{"density", "=", RowBox[{RowBox[{FractionBox["1", 
                    "2"], " ", RowBox[{"(", RowBox[{RowBox[{"vectorX", ".", 
                         "vectorX"}], "+", RowBox[{"vectorY", ".", 
                         "vectorY"}]}], ")"}]}], "+", RowBox[{"atPhiZero", 
                   ".", RowBox[{"{", RowBox[{RowBox[{"vectorY", 
                         "\[LeftDoubleBracket]", "3", 
                         "\[RightDoubleBracket]"}], ",", RowBox[{"-", 
                         RowBox[{"vectorX", "\[LeftDoubleBracket]", "3", 
                          "\[RightDoubleBracket]"}]}], ",", RowBox[
                        {RowBox[{"vectorX", "\[LeftDoubleBracket]", "2", 
                          "\[RightDoubleBracket]"}], "-", RowBox[{"vectorY", 
                          "\[LeftDoubleBracket]", "1", 
                          "\[RightDoubleBracket]"}]}]}], "}"}]}], "-", 
                 RowBox[{"field", " ", RowBox[{"atPhiZero", 
                     "\[LeftDoubleBracket]", "3", 
                     "\[RightDoubleBracket]"}]}]}]}], ";", 
             RowBox[{"expansion", "=", RowBox[{"Normal", "[", RowBox[
                  {"Series", "[", RowBox[{"density", ",", RowBox[{"{", 
                       RowBox[{"amplitude", ",", "0", ",", "2"}], "}"}]}], 
                   "]"}], "]"}]}], ";", RowBox[{"zerothOrder", "=", RowBox[
                {"FullSimplify", "[", RowBox[{"Coefficient", "[", 
                   RowBox[{"expansion", ",", "amplitude", ",", "0"}], "]"}], 
                 "]"}]}], ";", RowBox[{"firstOrder", "=", RowBox[
                {"FullSimplify", "[", RowBox[{"Coefficient", "[", 
                   RowBox[{"expansion", ",", "amplitude", ",", "1"}], "]"}], 
                 "]"}]}], ";", RowBox[{"secondOrder", "=", RowBox[
                {"FullSimplify", "[", RowBox[{"Coefficient", "[", 
                   RowBox[{"expansion", ",", "amplitude", ",", "2"}], "]"}], 
                 "]"}]}], ";", RowBox[{"equation9", "=", RowBox[{"curvature", 
                 "+", FractionBox["slope", "rad"], "-", FractionBox[
                  RowBox[{RowBox[{"Sin", "[", "theta", "]"}], " ", 
                    RowBox[{"Cos", "[", "theta", "]"}]}], SuperscriptBox[
                   "rad", "2"]], "+", FractionBox[RowBox[{"2", " ", 
                    SuperscriptBox[RowBox[{"Sin", "[", "theta", "]"}], 
                     "2"]}], "rad"], "-", RowBox[{"field", " ", RowBox[
                    {"Sin", "[", "theta", "]"}]}]}]}], ";", 
             RowBox[{"linearDivergence", "=", RowBox[{FractionBox[
                  RowBox[{"radialDerivative", "[", RowBox[{"rad", " ", 
                      RowBox[{"(", RowBox[{"slope", "+", "1"}], ")"}], " ", 
                      "tx"}], "]"}], "rad"], "+", RowBox[
                  {"angularDerivative", "[", RowBox[{RowBox[{"(", RowBox[
                        {FractionBox[RowBox[{"Sin", "[", "theta", "]"}], 
                          SuperscriptBox["rad", "2"]], "+", FractionBox[
                          RowBox[{"Cos", "[", "theta", "]"}], "rad"]}], 
                       ")"}], " ", "ty"}], "]"}]}]}], ";", 
             RowBox[{"normalPotential", "=", RowBox[{"FullSimplify", "[", 
                 RowBox[{FractionBox["1", "2"], " ", RowBox[{"(", RowBox[
                      {RowBox[{SubscriptBox["\[PartialD]", RowBox[{RowBox[
                          {"{", RowBox[{"tx", ",", "2"}], "}"}]}]], 
                         "secondOrder"}], "+", RowBox[{SubscriptBox[
                          "\[PartialD]", RowBox[{RowBox[{"{", RowBox[{"ty", 
                          ",", "2"}], "}"}]}]], "secondOrder"}]}], ")"}]}], 
                 "]"}]}], ";", RowBox[{"anomalousPotential", "=", RowBox[
                {"FullSimplify", "[", RowBox[{FractionBox["1", "2"], " ", 
                   RowBox[{"(", RowBox[{RowBox[{SubscriptBox["\[PartialD]", 
                          RowBox[{RowBox[{"{", RowBox[{"tx", ",", "2"}], 
                          "}"}]}]], "secondOrder"}], "-", RowBox[
                        {SubscriptBox["\[PartialD]", RowBox[{RowBox[{"{", 
                          RowBox[{"ty", ",", "2"}], "}"}]}]], 
                         "secondOrder"}]}], ")"}]}], "]"}]}], ";", 
             RowBox[{"angularCoefficient", "=", RowBox[{"FullSimplify", "[", 
                 RowBox[{RowBox[{"-", "2"}], " ", RowBox[{SubscriptBox[
                      "\[PartialD]", RowBox[{"tyPhi"}]], RowBox[{SubscriptBox[
                        "\[PartialD]", RowBox[{"tx"}]], "secondOrder"}]}]}], 
                 "]"}]}], ";", RowBox[{"paperU", "=", RowBox[
                {FractionBox[RowBox[{"1", "+", RowBox[{"3", " ", RowBox[
                       {"Cos", "[", RowBox[{"2", " ", "theta"}], "]"}]}]}], 
                  RowBox[{"4", " ", SuperscriptBox["rad", "2"]}]], "-", 
                 FractionBox[SuperscriptBox["slope", "2"], "2"], "-", 
                 FractionBox[RowBox[{"3", " ", RowBox[{"Sin", "[", RowBox[
                       {"2", " ", "theta"}], "]"}]}], RowBox[{"2", " ", 
                    "rad"}]], "-", "slope", "+", RowBox[{"field", " ", 
                   RowBox[{"Cos", "[", "theta", "]"}]}]}]}], ";", 
             RowBox[{"paperG", "=", RowBox[{RowBox[{FractionBox["1", "2"], 
                   " ", RowBox[{"(", RowBox[{RowBox[{"-", FractionBox[
                          SuperscriptBox[RowBox[{"Sin", "[", "theta", "]"}], 
                          "2"], SuperscriptBox["rad", "2"]]}], "+", 
                       SuperscriptBox["slope", "2"]}], ")"}]}], "+", "slope", 
                 "-", FractionBox[RowBox[{"Sin", "[", RowBox[{"2", " ", 
                      "theta"}], "]"}], RowBox[{"2", " ", "rad"}]]}]}], ";", 
             RowBox[{"paperA", "=", RowBox[{RowBox[{"-", FractionBox[
                    RowBox[{"2", " ", RowBox[{"Cos", "[", "theta", "]"}]}], 
                    SuperscriptBox["rad", "2"]]}], "+", FractionBox[
                  RowBox[{"2", " ", RowBox[{"Sin", "[", "theta", "]"}]}], 
                  "rad"]}]}], ";", RowBox[{"gradientForm", "=", RowBox[
                {RowBox[{FractionBox["1", "2"], " ", RowBox[{"(", RowBox[
                      {SuperscriptBox["txRad", "2"], "+", SuperscriptBox[
                        "tyRad", "2"], "+", FractionBox[RowBox[
                         {SuperscriptBox["txPhi", "2"], "+", SuperscriptBox[
                          "tyPhi", "2"]}], SuperscriptBox["rad", "2"]]}], 
                     ")"}]}], "-", RowBox[{FractionBox["1", "2"], " ", 
                   "paperA", " ", RowBox[{"(", RowBox[{RowBox[{"tx", " ", 
                         "tyPhi"}], "-", RowBox[{"ty", " ", "txPhi"}]}], 
                     ")"}]}], "+", RowBox[{FractionBox["1", "2"], " ", 
                   "paperU", " ", RowBox[{"(", RowBox[{SuperscriptBox["tx", 
                        "2"], "+", SuperscriptBox["ty", "2"]}], ")"}]}], "+", 
                 RowBox[{FractionBox["1", "2"], " ", "paperG", " ", 
                   RowBox[{"(", RowBox[{SuperscriptBox["tx", "2"], "-", 
                       SuperscriptBox["ty", "2"]}], ")"}]}]}]}], ";", 
             RowBox[{"assumptions", "=", RowBox[{RowBox[{"rad", ">", "0"}], 
                 "&&", RowBox[{RowBox[{"{", RowBox[{"theta", ",", "slope", 
                       ",", "curvature", ",", "field", ",", "tx", ",", "ty", 
                       ",", "txRad", ",", "tyRad", ",", "txPhi", ",", 
                       "tyPhi"}], "}"}], "\[Element]", TemplateBox[{}, 
                    "Reals"]}]}]}], ";", RowBox[{"checks", "=", RowBox[
                {"{", RowBox[{RowBox[{"{", RowBox[
                      {"\"Exact normalization of n(lambda)\"", ",", RowBox[
                        {"FullSimplify", "[", RowBox[{RowBox[{"atPhiZero", 
                          ".", "atPhiZero"}], "-", "1"}], "]"}]}], "}"}], 
                   ",", RowBox[{"{", RowBox[
                      {"\"lambda^0: classical continuum density\"", ",", 
                       RowBox[{"FullSimplify", "[", RowBox[{RowBox[
                          {"zerothOrder", "-", RowBox[{"(", RowBox[
                          {FractionBox[SuperscriptBox["slope", "2"], "2"], 
                          "+", FractionBox[SuperscriptBox[RowBox[{"Sin", "[", 
                          "theta", "]"}], "2"], RowBox[{"2", " ", 
                          SuperscriptBox["rad", "2"]}]], "+", "slope", "+", 
                          FractionBox[RowBox[{"Sin", "[", RowBox[{"2", " ", 
                          "theta"}], "]"}], RowBox[{"2", " ", "rad"}]], "-", 
                          RowBox[{"field", " ", RowBox[{"Cos", "[", "theta", 
                          "]"}]}]}], ")"}]}], ",", "assumptions"}], "]"}]}], 
                     "}"}], ",", RowBox[{"{", RowBox[{"\"lambda^1: -tx times \
Eq. (9), plus explicit divergences\"", ",", RowBox[{"FullSimplify", "[", 
                         RowBox[{RowBox[{"firstOrder", "+", RowBox[{"tx", 
                          " ", "equation9"}], "-", "linearDivergence"}], ",", 
                          "assumptions"}], "]"}]}], "}"}], ",", RowBox[
                    {"{", RowBox[
                      {"\"lambda^2: normal potential U in Eq. (11)\"", ",", 
                       RowBox[{"FullSimplify", "[", RowBox[{RowBox[
                          {"normalPotential", "-", "paperU"}], ",", 
                          "assumptions"}], "]"}]}], "}"}], ",", RowBox[
                    {"{", RowBox[
                      {"\"lambda^2: anomalous potential G in Eq. (11)\"", 
                       ",", RowBox[{"FullSimplify", "[", RowBox[{RowBox[
                          {"anomalousPotential", "-", "paperG"}], ",", 
                          "assumptions"}], "]"}]}], "}"}], ",", RowBox[
                    {"{", RowBox[
                      {"\"lambda^2: angular Lz coefficient in Eq. (11)\"", 
                       ",", RowBox[{"FullSimplify", "[", RowBox[{RowBox[
                          {"angularCoefficient", "-", "paperA"}], ",", 
                          "assumptions"}], "]"}]}], "}"}], ",", RowBox[
                    {"{", RowBox[{"\"Full quadratic Hessian minus Eq. \
(10)-(11) gradient form\"", ",", RowBox[{"FullSimplify", "[", RowBox[
                          {RowBox[{"secondOrder", "-", "gradientForm"}], ",", 
