  Cell["6. Three dimensions and finite-temperature fluctuations", "Section"], 
  Cell["Equations (22)-(23) prescribe a rigid longitudinal shift \
epsilon(k,kz)=epsilon(k)+C kz^2. This is the paper approximation. For nonzero \
pairing, adding longitudinal exchange to the microscopic BdG operator instead \
adds kz^2 tau3 to the dynamical matrix, and its eigenvalues need not shift \
rigidly. Both are compared below. The thermal infrared model is separately \
Goldstone-constrained, has unit mode weight, and uses a circular in-plane \
cutoff to expose the 2D logarithmic divergence and finite 3D integral. It \
does not clip or repair the signed WKB bands. The cylindrical cutoff is a \
stated approximation to the hexagonal Brillouin zone.", "Text"], 
  Cell[CellGroupData[
    {Cell[BoxData[RowBox[{"Module", "[", 
         RowBox[{RowBox[{"{", RowBox[{RowBox[{"longitudinalStiffness", "=", 
                 "1"}], ",", RowBox[{"planarStiffness", "=", FractionBox["1", 
                  "5"]}], ",", RowBox[{"temperature", "=", FractionBox["1", 
                  "10"]}], ",", RowBox[{"inPlaneCutoff", "=", "1"}], ",", 
               RowBox[{"normalValue", "=", "1"}], ",", RowBox[
                {"pairingValue", "=", FractionBox["2", "5"]}], ",", "kz", 
               ",", "normalSymbol", ",", "pairingSymbol", ",", "shift", ",", 
               "exactExchangeEnergy", ",", "rigidEnergy", ",", 
               "identityResidual", ",", "derivativeResidual", ",", 
               "classical2D", ",", "classical3D", ",", "bose2D", ",", 
               "bose3D", ",", "boseIntegrand", ",", "logOneMinusExp", ",", 
               "zValue", ",", "jacobian", ",", "exponent0", ",", "exponent1", 
               ",", "numericalBose3D", ",", "analyticBose3D", ",", 
               "relativeResidual", ",", "occupationPlot", ",", "shiftPlot", 
               ",", "momentumMinimum", ",", "t", ",", "report"}], "}"}], ",", 
           RowBox[{RowBox[{"exactExchangeEnergy", "=", SqrtBox[
                RowBox[{SuperscriptBox[RowBox[{"(", RowBox[{"normalSymbol", 
                       "+", "shift"}], ")"}], "2"], "-", SuperscriptBox[
                   "pairingSymbol", "2"]}]]}], ";", RowBox[{"rigidEnergy", 
               "=", RowBox[{SqrtBox[RowBox[{SuperscriptBox["normalSymbol", 
                     "2"], "-", SuperscriptBox["pairingSymbol", "2"]}]], "+", 
                 "shift"}]}], ";", RowBox[{"identityResidual", "=", RowBox[
                {"Simplify", "[", RowBox[{SuperscriptBox[
                    "exactExchangeEnergy", "2"], "-", SuperscriptBox[
                    "rigidEnergy", "2"], "-", RowBox[{"2", " ", "shift", " ", 
                     RowBox[{"(", RowBox[{"normalSymbol", "-", SqrtBox[
                          RowBox[{SuperscriptBox["normalSymbol", "2"], "-", 
                          SuperscriptBox["pairingSymbol", "2"]}]]}], 
                       ")"}]}]}], "]"}]}], ";", RowBox[{"derivativeResidual", 
               "=", RowBox[{"Simplify", "[", RowBox[{RowBox[{"(", RowBox[
                      {RowBox[{SubscriptBox["\[PartialD]", RowBox[
                          {"shift"}]], "exactExchangeEnergy"}], "/.", 
                       "\[VeryThinSpace]", RowBox[{"shift", "\[Rule]", 
                         "0"}]}], ")"}], "-", FractionBox["normalSymbol", 
                    SqrtBox[RowBox[{SuperscriptBox["normalSymbol", "2"], "-", 
                       SuperscriptBox["pairingSymbol", "2"]}]]]}], "]"}]}], 
             ";", RowBox[{RowBox[{"classical2D", "[", RowBox[{"minimum_", 
                   "?", "NumericQ"}], "]"}], ":=", FractionBox[
                RowBox[{"temperature", " ", RowBox[{"Log", "[", FractionBox[
                     "inPlaneCutoff", "minimum"], "]"}]}], RowBox[
                 {"2", " ", "\[Pi]", " ", "planarStiffness"}]]}], ";", 
             RowBox[{RowBox[{"classical3D", "[", RowBox[{"minimum_", "?", 
                   "NumericQ"}], "]"}], ":=", FractionBox[RowBox[
                 {"temperature", " ", RowBox[{"(", RowBox[{"inPlaneCutoff", 
                      "-", "minimum"}], ")"}]}], RowBox[{"4", " ", "\[Pi]", 
                  " ", SqrtBox[RowBox[{"longitudinalStiffness", " ", 
                     "planarStiffness"}]]}]]}], ";", 
             RowBox[{RowBox[{"bose2D", "[", RowBox[{"minimum_", "?", 
                   "NumericQ"}], "]"}], ":=", FractionBox[RowBox[
                 {"temperature", " ", RowBox[{"Log", "[", FractionBox[
                     RowBox[{"1", "-", RowBox[{"Exp", "[", RowBox[{"-", 
                          FractionBox[RowBox[{"planarStiffness", " ", 
                          SuperscriptBox["inPlaneCutoff", "2"]}], 
                          "temperature"]}], "]"}]}], RowBox[{"1", "-", 
                       RowBox[{"Exp", "[", RowBox[{"-", FractionBox[RowBox[
                          {"planarStiffness", " ", SuperscriptBox["minimum", 
                          "2"]}], "temperature"]}], "]"}]}]], "]"}]}], 
                RowBox[{"4", " ", "\[Pi]", " ", "planarStiffness"}]]}], ";", 
             RowBox[{RowBox[{"bose3D", "[", RowBox[{"minimum_", "?", 
                   "NumericQ"}], "]"}], ":=", FractionBox[RowBox[
                 {SuperscriptBox["temperature", RowBox[{"3", "/", "2"}]], 
                  " ", RowBox[{"(", RowBox[{RowBox[{"PolyLog", "[", RowBox[
                         {FractionBox["3", "2"], ",", RowBox[{"Exp", "[", 
                          RowBox[{"-", FractionBox[RowBox[{"planarStiffness", 
                          " ", SuperscriptBox["minimum", "2"]}], 
                          "temperature"]}], "]"}]}], "]"}], "-", RowBox[
                       {"PolyLog", "[", RowBox[{FractionBox["3", "2"], ",", 
                          RowBox[{"Exp", "[", RowBox[{"-", FractionBox[RowBox[
                          {"planarStiffness", " ", SuperscriptBox[
                          "inPlaneCutoff", "2"]}], "temperature"]}], "]"}]}], 
                        "]"}]}], ")"}]}], RowBox[{"8", " ", SuperscriptBox[
                   "\[Pi]", RowBox[{"3", "/", "2"}]], " ", "planarStiffness", 
                  " ", SqrtBox["longitudinalStiffness"]}]]}], ";", 
             RowBox[{RowBox[{"logOneMinusExp", "[", RowBox[{"value_", "?", 
                   "NumericQ"}], "]"}], ":=", RowBox[{"If", "[", 
                 RowBox[{RowBox[{"value", "<", RowBox[{"Log", "[", "2", 
                       "]"}]}], ",", RowBox[{RowBox[{"Log", "[", RowBox[
                        {"2", " ", RowBox[{"Sinh", "[", FractionBox["value", 
                          "2"], "]"}]}], "]"}], "-", FractionBox["value", 
                      "2"]}], ",", RowBox[{"Log", "[", RowBox[{"1", "-", 
                       RowBox[{"Exp", "[", RowBox[{"-", "value"}], "]"}]}], 
                     "]"}]}], "]"}]}], ";", RowBox[{RowBox[{"boseIntegrand", 
                 "[", RowBox[{"parameter_", "?", "NumericQ"}], "]"}], ":=", 
               RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"parameter", 
                       "\[LessEqual]", "0"}], "||", RowBox[{"parameter", 
                       "\[GreaterEqual]", "1"}]}], ",", "0", ",", 
                   RowBox[{RowBox[{"zValue", "=", FractionBox[RowBox[
                         {SqrtBox[FractionBox["temperature", 
                          "longitudinalStiffness"]], " ", SuperscriptBox[
                          "parameter", "2"]}], RowBox[{"1", "-", 
                          "parameter"}]]}], ";", RowBox[{"jacobian", "=", 
                       FractionBox[RowBox[{SqrtBox[FractionBox["temperature", 
                          "longitudinalStiffness"]], " ", "parameter", " ", 
                          RowBox[{"(", RowBox[{"2", "-", "parameter"}], 
                          ")"}]}], SuperscriptBox[RowBox[{"(", RowBox[{"1", 
                          "-", "parameter"}], ")"}], "2"]]}], ";", RowBox[
                      {"exponent0", "=", FractionBox[RowBox[
                         {"longitudinalStiffness", " ", SuperscriptBox[
                          "zValue", "2"]}], "temperature"]}], ";", RowBox[
                      {"exponent1", "=", FractionBox[RowBox[{RowBox[
                          {"planarStiffness", " ", SuperscriptBox[
                          "inPlaneCutoff", "2"]}], "+", RowBox[
                          {"longitudinalStiffness", " ", SuperscriptBox[
                          "zValue", "2"]}]}], "temperature"]}], ";", 
                     RowBox[{"jacobian", " ", RowBox[{"(", RowBox[
                          {RowBox[{"logOneMinusExp", "[", "exponent1", "]"}], 
                          "-", RowBox[{"logOneMinusExp", "[", "exponent0", 
                          "]"}]}], ")"}]}]}]}], "]"}]}], ";", 
             RowBox[{"numericalBose3D", "=", FractionBox[RowBox[
                 {"temperature", " ", RowBox[{"NIntegrate", "[", RowBox[
                     {RowBox[{"boseIntegrand", "[", "t", "]"}], ",", 
                      RowBox[{"{", RowBox[{"t", ",", "0", ",", "1"}], "}"}], 
                      ",", RowBox[{"WorkingPrecision", "\[Rule]", "35"}], 
                      ",", RowBox[{"AccuracyGoal", "\[Rule]", "18"}], ",", 
                      RowBox[{"PrecisionGoal", "\[Rule]", "16"}], ",", 
                      RowBox[{"Method", "\[Rule]", RowBox[{"{", RowBox[
                          {"\"GlobalAdaptive\"", ",", RowBox[
                          {"\"SymbolicProcessing\"", "\[Rule]", "0"}]}], 
                          "}"}]}]}], "]"}]}], RowBox[{"4", " ", 
                  SuperscriptBox["\[Pi]", "2"], " ", "planarStiffness"}]]}], 
             ";", RowBox[{"analyticBose3D", "=", RowBox[{"N", "[", 
                 RowBox[{RowBox[{"bose3D", "[", "0", "]"}], ",", "25"}], 
                 "]"}]}], ";", RowBox[{"relativeResidual", "=", FractionBox[
                RowBox[{"Abs", "[", RowBox[{"numericalBose3D", "-", 
                    "analyticBose3D"}], "]"}], RowBox[{"Abs", "[", 
                  "analyticBose3D", "]"}]]}], ";", RowBox[{"occupationPlot", 
               "=", RowBox[{"LogLinearPlot", "[", RowBox[{RowBox[{"{", 
                     RowBox[{RowBox[{"classical2D", "[", "momentumMinimum", 
                         "]"}], ",", RowBox[{"classical3D", "[", 
                         "momentumMinimum", "]"}], ",", RowBox[{"bose3D", 
                         "[", "momentumMinimum", "]"}]}], "}"}], ",", 
                   RowBox[{"{", RowBox[{"momentumMinimum", ",", FractionBox[
                        "1", SuperscriptBox["10", "5"]], ",", 
                       "inPlaneCutoff"}], "}"}], ",", RowBox[{"Frame", 
                     "\[Rule]", "True"}], ",", RowBox[{"FrameLabel", 
                     "\[Rule]", RowBox[{"{", RowBox[
                        {"\"infrared cutoff k_min / Lambda (Lambda=1)\"", 
                         ",", 
                         "\"integrated occupation; unit mode weight\""}], 
                       "}"}]}], ",", RowBox[{"PlotLegends", "\[Rule]", 
                     RowBox[{"{", RowBox[{"\"2D classical infrared\"", ",", 
                         "\"3D classical infrared\"", ",", 
                         "\"3D full Bose distribution\""}], "}"}]}], ",", 
                   RowBox[{"PlotStyle", "\[Rule]", RowBox[{"{", RowBox[
                        {RowBox[{"{", RowBox[{"Thick", ",", "Red"}], "}"}], 
                         ",", RowBox[{"{", RowBox[{"Thick", ",", "Blue"}], 
                          "}"}], ",", RowBox[{"{", RowBox[{"Thick", ",", 
                          RowBox[{"Darker", "[", "Green", "]"}], ",", 
                          "Dashed"}], "}"}]}], "}"}]}], ",", RowBox[
                    {"PlotRange", "\[Rule]", "All"}], ",", RowBox[
                    {"ImageSize", "\[Rule]", "600"}]}], "]"}]}], ";", 
             RowBox[{"shiftPlot", "=", RowBox[{"Plot", "[", RowBox[
                  {RowBox[{"Evaluate", "[", RowBox[{RowBox[{"{", RowBox[
                          {RowBox[{SqrtBox[RowBox[{SuperscriptBox[
                          "normalSymbol", "2"], "-", SuperscriptBox[
                          "pairingSymbol", "2"]}]], "+", RowBox[
                          {"longitudinalStiffness", " ", SuperscriptBox["kz", 
                          "2"]}]}], ",", SqrtBox[RowBox[{SuperscriptBox[
                          RowBox[{"(", RowBox[{"normalSymbol", "+", RowBox[
                          {"longitudinalStiffness", " ", SuperscriptBox["kz", 
                          "2"]}]}], ")"}], "2"], "-", SuperscriptBox[
                          "pairingSymbol", "2"]}]]}], "}"}], "/.", 
                       "\[VeryThinSpace]", RowBox[{"{", RowBox[{RowBox[
                          {"normalSymbol", "\[Rule]", "normalValue"}], ",", 
                          RowBox[{"pairingSymbol", "\[Rule]", 
                          "pairingValue"}]}], "}"}]}], "]"}], ",", 
                   RowBox[{"{", RowBox[{"kz", ",", "0", ",", "1"}], "}"}], 
                   ",", RowBox[{"Frame", "\[Rule]", "True"}], ",", 
                   RowBox[{"FrameLabel", "\[Rule]", RowBox[{"{", RowBox[
                        {"\"k_z\"", ",", "\"positive excitation energy\""}], 
                       "}"}]}], ",", RowBox[{"PlotLegends", "\[Rule]", 
                     RowBox[{"{", RowBox[{"\"paper rigid shift, Eq. (22)\"", 
                         ",", 
                         "\"exact 2x2 BdG, longitudinal exchange only\""}], 
                       "}"}]}], ",", RowBox[{"PlotStyle", "\[Rule]", 
                     RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"Thick", ",", 
                          "Blue"}], "}"}], ",", RowBox[{"{", RowBox[{"Thick", 
                          ",", "Red", ",", "Dashed"}], "}"}]}], "}"}]}], ",", 
                   RowBox[{"ImageSize", "\[Rule]", "600"}]}], "]"}]}], ";", 
             RowBox[{"report", "=", RowBox[{"{", RowBox[{RowBox[{"{", 
                     RowBox[{"\"Illustrative dimensionless parameters\"", 
                       ",", "\"T=0.1, Cz=1, Cp=0.2, Lambda=1\""}], "}"}], 
                   ",", RowBox[{"{", RowBox[
                      {"\"Momentum normalization / integration domain\"", 
                       ",", "\"d^d k/(2 pi)^d; k_min<=|k_parallel|<=Lambda, \
k_z in R\""}], "}"}], ",", RowBox[{"{", RowBox[
                      {"\"Eq. (22) is a rigid-shift approximation when \
pairing is nonzero\"", ",", 
                       "\"BdG: H(kz)=H(0)+Cz kz^2 identity; dynamical matrix \
gains Cz kz^2 sigma3\""}], "}"}], ",", RowBox[{"{", RowBox[
                      {"\"Exact minus rigid squared energy identity \
residual\"", ",", "identityResidual"}], "}"}], ",", RowBox[{"{", RowBox[
                      {
                       "\"d epsilon / d(Cz kz^2)=F/sqrt(F^2-G^2), residual\""\
, ",", "derivativeResidual"}], "}"}], ",", RowBox[{"{", RowBox[
                      {"\"3D classical infrared occupation, k_min=0\"", ",", 
                       RowBox[{"N", "[", RowBox[{RowBox[{"classical3D", "[", 
