      "Output"]}, Open]], Cell["Equation (3) is checked as an exact \
differential representation on an arbitrary test function. The following \
continuum expansion then derives the constant, linear and full quadratic \
spin-wave terms directly, including the explicit divergence that removes the \
linear source when Eq. (9) holds. The Appendix B pairing phase is introduced \
by the Nambu gauge documented above.", "Text"], 
  Cell[CellGroupData[
    {Cell[BoxData[RowBox[{"Module", "[", 
         RowBox[{RowBox[{"{", RowBox[{"spin", ",", "coord", ",", 
               "testFunction", ",", "raising", ",", "lowering", ",", 
               "longitudinal", ",", "checks"}], "}"}], ",", 
           RowBox[{RowBox[{RowBox[{"raising", "[", "expr_", "]"}], ":=", 
               RowBox[{SqrtBox[RowBox[{"2", " ", "spin"}]], " ", 
                 RowBox[{SubscriptBox["\[PartialD]", RowBox[{"coord"}]], 
                   "expr"}]}]}], ";", RowBox[{RowBox[{"lowering", "[", 
                 "expr_", "]"}], ":=", RowBox[{SqrtBox[RowBox[{"2", " ", 
                    "spin"}]], " ", RowBox[{"(", RowBox[{RowBox[{"coord", 
                       " ", "expr"}], "-", FractionBox[RowBox[{SuperscriptBox[
                         "coord", "2"], " ", RowBox[{SubscriptBox[
                          "\[PartialD]", RowBox[{"coord"}]], "expr"}]}], 
                      RowBox[{"2", " ", "spin"}]]}], ")"}]}]}], ";", 
             RowBox[{RowBox[{"longitudinal", "[", "expr_", "]"}], ":=", 
               RowBox[{RowBox[{"spin", " ", "expr"}], "-", RowBox[{"coord", 
                   " ", RowBox[{SubscriptBox["\[PartialD]", RowBox[
                       {"coord"}]], "expr"}]}]}]}], ";", 
             RowBox[{"checks", "=", RowBox[{"{", RowBox[{RowBox[{"{", 
                     RowBox[{"\"[Sz,S+] = S+\"", ",", RowBox[{"Simplify", 
                         "[", RowBox[{RowBox[{"longitudinal", "[", RowBox[
                          {"raising", "[", RowBox[{"testFunction", "[", 
                          "coord", "]"}], "]"}], "]"}], "-", RowBox[
                          {"raising", "[", RowBox[{"longitudinal", "[", 
                          RowBox[{"testFunction", "[", "coord", "]"}], "]"}], 
                          "]"}], "-", RowBox[{"raising", "[", RowBox[
                          {"testFunction", "[", "coord", "]"}], "]"}]}], 
                         "]"}]}], "}"}], ",", RowBox[{"{", RowBox[
                      {"\"[Sz,S-] = -S-\"", ",", RowBox[{"Simplify", "[", 
                         RowBox[{RowBox[{"longitudinal", "[", RowBox[
                          {"lowering", "[", RowBox[{"testFunction", "[", 
                          "coord", "]"}], "]"}], "]"}], "-", RowBox[
                          {"lowering", "[", RowBox[{"longitudinal", "[", 
                          RowBox[{"testFunction", "[", "coord", "]"}], "]"}], 
                          "]"}], "+", RowBox[{"lowering", "[", RowBox[
                          {"testFunction", "[", "coord", "]"}], "]"}]}], 
                         "]"}]}], "}"}], ",", RowBox[{"{", RowBox[
                      {"\"[S+,S-] = 2 Sz\"", ",", RowBox[{"Simplify", "[", 
                         RowBox[{RowBox[{"raising", "[", RowBox[{"lowering", 
                          "[", RowBox[{"testFunction", "[", "coord", "]"}], 
                          "]"}], "]"}], "-", RowBox[{"lowering", "[", RowBox[
                          {"raising", "[", RowBox[{"testFunction", "[", 
                          "coord", "]"}], "]"}], "]"}], "-", RowBox[{"2", 
                          " ", RowBox[{"longitudinal", "[", RowBox[
                          {"testFunction", "[", "coord", "]"}], "]"}]}]}], 
                         "]"}]}], "}"}], ",", RowBox[{"{", RowBox[
                      {"\"Representation\"", ",", "\"Maleyev-Dyson Eq. (3), \
exact commutators; S- is not the naive adjoint in the full auxiliary Fock \
space\""}], "}"}]}], "}"}]}], ";", RowBox[{"Grid", "[", RowBox[
                {RowBox[{"Prepend", "[", RowBox[{"checks", ",", RowBox[
                      {"{", RowBox[{"\"Eq. (3) commutator acting on an \
arbitrary test function\"", ",", "\"Residual (zero) / note\""}], "}"}]}], 
                   "]"}], ",", RowBox[{"Frame", "\[Rule]", "All"}], ",", 
                 RowBox[{"Alignment", "\[Rule]", "Left"}], ",", 
                 RowBox[{"Background", "\[Rule]", RowBox[{"{", RowBox[
                      {"None", ",", RowBox[{"{", RowBox[{"LightGray", ",", 
                          "None"}], "}"}]}], "}"}]}]}], "]"}]}]}], "]"}]], 
      "Input", CellLabel -> "In[4]:=", CellTags -> 
       {"maleyev-dyson-commutators"}], 
     Cell[BoxData[TagBox[GridBox[
         {{"\"Eq. (3) commutator acting on an arbitrary test function\"", 
