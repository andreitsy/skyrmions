  Cell["3. Disk magnons and energetic stability", "Section"], 
  Cell["Appendix B is evaluated by Gauss-Legendre quadrature with measure r \
dr. The dynamical matrix is Lm={{Fm,Gm},{-Transpose[Gm],-FminusM}}. Physical \
states have positive bosonic norm u.u-v.v=1; their energy is kept signed so \
an instability cannot be hidden by Abs. The symmetric energy Hessian is \
tau3.Lm. Both component Gram matrices, pseudo-Hermiticity and eigenpair \
residuals are checked.", "Text"], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"zeros", "[", RowBox[{"order_Integer", ",", 
            "n_Integer"}], "]"}], ":=", 
        RowBox[{RowBox[{"zeros", "[", RowBox[{"order", ",", "n"}], "]"}], 
          "=", RowBox[{"N", "[", RowBox[{"Table", "[", RowBox[{
                RowBox[{"BesselJZero", "[", RowBox[{RowBox[{"Abs", "[", 
                      "order", "]"}], ",", "j"}], "]"}], ",", RowBox[
                 {"{", RowBox[{"j", ",", "n"}], "}"}]}], "]"}], "]"}]}]}], 
      ";", RowBox[{RowBox[{"basis", "[", RowBox[{"order_Integer", ",", 
            "n_Integer", ",", RowBox[{"radius_", "?", "NumericQ"}], ",", 
            "rs_List"}], "]"}], ":=", RowBox[{"Module", "[", 
          RowBox[{RowBox[{"{", RowBox[{RowBox[{"nu", "=", RowBox[{"Abs", "[", 
                    "order", "]"}]}], ",", RowBox[{"zz", "=", RowBox[
                   {"zeros", "[", RowBox[{"order", ",", "n"}], "]"}]}]}], 
              "}"}], ",", RowBox[{"Table", "[", RowBox[{FractionBox[
                 RowBox[{SqrtBox["2.`"], " ", RowBox[{"BesselJ", "[", 
                     RowBox[{"nu", ",", FractionBox[RowBox[{RowBox[{"zz", 
                          "\[LeftDoubleBracket]", "j", 
                          "\[RightDoubleBracket]"}], " ", "rs"}], 
                        "radius"]}], "]"}]}], RowBox[{"radius", " ", 
                   RowBox[{"Abs", "[", RowBox[{"BesselJ", "[", RowBox[
                        {RowBox[{"nu", "+", "1"}], ",", RowBox[{"zz", 
                          "\[LeftDoubleBracket]", "j", 
                          "\[RightDoubleBracket]"}]}], "]"}], "]"}]}]], ",", 
                RowBox[{"{", RowBox[{"j", ",", "n"}], "}"}]}], "]"}]}], 
          "]"}]}], ";", RowBox[{RowBox[{"quadRule", "[", "q_Integer", "]"}], 
        ":=", RowBox[{RowBox[{"quadRule", "[", "q", "]"}], "=", 
          RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                 {RowBox[{"j", "=", RowBox[{"Range", "[", RowBox[{"q", "-", 
                        "1"}], "]"}]}], ",", "vals", ",", "vecs", ",", 
                  "ind"}], "}"}], ",", RowBox[{RowBox[{RowBox[{"{", 
                    RowBox[{"vals", ",", "vecs"}], "}"}], "=", RowBox[
                   {"Eigensystem", "[", RowBox[{"N", "[", RowBox[{"Normal", 
                        "[", RowBox[{"SparseArray", "[", RowBox[{RowBox[
                          {"{", RowBox[{RowBox[{RowBox[{"Band", "[", RowBox[
                          {"{", RowBox[{"1", ",", "2"}], "}"}], "]"}], 
                          "\[Rule]", FractionBox["j", SqrtBox[RowBox[{RowBox[
                          {"4", " ", SuperscriptBox["j", "2"]}], "-", 
                          "1"}]]]}], ",", RowBox[{RowBox[{"Band", "[", RowBox[
                          {"{", RowBox[{"2", ",", "1"}], "}"}], "]"}], 
                          "\[Rule]", FractionBox["j", SqrtBox[RowBox[{RowBox[
                          {"4", " ", SuperscriptBox["j", "2"]}], "-", 
                          "1"}]]]}]}], "}"}], ",", RowBox[{"{", RowBox[{"q", 
                          ",", "q"}], "}"}]}], "]"}], "]"}], "]"}], "]"}]}], 
                ";", RowBox[{"ind", "=", RowBox[{"Ordering", "[", "vals", 
                    "]"}]}], ";", TemplateBox[{RowBox[{"{", RowBox[
                     {RowBox[{FractionBox["1", "2"], " ", RowBox[{"(", 
                          RowBox[{RowBox[{"vals", "\[LeftDoubleBracket]", 
                          "ind", "\[RightDoubleBracket]"}], "+", "1"}], 
                          ")"}]}], ",", SuperscriptBox[RowBox[{"vecs", 
                         "\[LeftDoubleBracket]", RowBox[{"ind", ",", "1"}], 
                         "\[RightDoubleBracket]"}], "2"]}], "}"}]}, 
                 "Transpose", SyntaxForm -> SuperscriptBox]}]}], "]"}]}]}], 
      ";", RowBox[{RowBox[{"sector", "[", RowBox[{"p_Association", ",", 
            "m_Integer", ",", "n_Integer", ",", "q_Integer"}], "]"}], ":=", 
        RowBox[{"sector", "[", RowBox[{RowBox[{"p", "[", "\"b\"", "]"}], ",", 
