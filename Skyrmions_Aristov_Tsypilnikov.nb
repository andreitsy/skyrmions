                   0.], AbsoluteThickness[2]], Directive[RGBColor[
                   0.8554632469481959, 0.24885384718327969, 
                   0.8334053873948551], AbsoluteThickness[2]], Directive[
                  RGBColor[0.032972823413648836, 0.7396719749139476, 
                   0.534700104525218], AbsoluteThickness[2]]}, 
               "DomainPadding" -> Scaled[0.02], "RangePadding" -> 
                Scaled[0.05], "OptimizePlotMarkers" -> True, 
               "IncludeHighlighting" -> Automatic, "HighlightStyle" -> 
                Automatic, "OptimizePlotMarkers" -> True, 
               "IncludeHighlighting" -> "CurrentSet", "HighlightStyle" -> 
                Automatic, "OptimizePlotMarkers" -> True, 
               "CoordinatesToolOptions" -> {"DisplayFunction" -> 
                  ({(Identity[#1] & )[#1[[1]]], (Identity[#1] & )[
                     #1[[2]]]} & ), "CopiedValueFunction" -> 
                  ({(Identity[#1] & )[#1[[1]]], (Identity[#1] & )[
                     #1[[2]]]} & )}}, PlotInteractivity :> True, 
             PlotLabel -> FormBox["\"Fig. 10: quantum spin reduction\"", 
               TraditionalForm], PlotRange -> {{0, 4.018913753672924}, {0, 
                0.018126871659082847}}, PlotRangeClipping -> True, 
             PlotRangePadding -> {{Scaled[0.02], Scaled[0.02]}, {
                Scaled[0.02], Scaled[0.05]}}, Ticks -> {Automatic, 
               Automatic}, PlotInteractivity :> True}]}, 
          {TagBox[GridBox[{{"\"Max local spin reduction\"", 
               "0.018126871659082847`"}, {"\"Integrated spin reduction\"", 
               "0.40477412147336284`"}, {"\"Sum of squared v coefficients\"", 
               "0.40477412147335723`"}, {"\"Normalization residual\"", 
               "5.6066262743570405`*^-15"}, {"\"Max change N=20 to 40\"", 
               "3.836381306087516`*^-6"}, {"\"Max change M=8 to 12\"", 
               "0.00023062337269405195`"}}, GridBoxAlignment -> 
              {"Columns" -> {{Left}}}, AutoDelete -> False, 
             GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
