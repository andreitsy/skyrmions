                     "}"}], ",", RowBox[{"{", RowBox[
                      {"\"Classical exchange: -m.partial^2 m = (partial \
m)^2\"", ",", RowBox[{"FullSimplify", "[", RowBox[{RowBox[{"-", RowBox[
                          {"localSpin", ".", RowBox[{SubscriptBox[
