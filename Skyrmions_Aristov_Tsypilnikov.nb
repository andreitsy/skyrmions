                   RowBox[{"{", RowBox[
                      {"\"3D full Bose occupation, analytic cylinder \
integral\"", ",", "analyticBose3D"}], "}"}], ",", RowBox[{"{", RowBox[
                      {"\"3D full Bose occupation, independent transformed \
quadrature\"", ",", "numericalBose3D"}], "}"}], ",", RowBox[{"{", RowBox[
                      {"\"Quadrature relative residual\"", ",", 
                       "relativeResidual"}], "}"}], ",", RowBox[{"{", 
                     RowBox[{"\"2D k_min -> 0\"", ",", 
                       "\"logarithmically divergent\""}], "}"}], ",", 
                   RowBox[{"{", RowBox[
                      {"\"Eq. (23) scaling using Cp~(0.8-b)C and \
Lambda~D/C\"", ",", 
                       "\"T D / (C^2 sqrt(0.8-b)), up to cutoff and \
mode-weight factors\""}], "}"}]}], "}"}]}], ";", TagBox[GridBox[{
