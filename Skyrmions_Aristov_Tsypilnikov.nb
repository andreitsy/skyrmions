      "Output"]}, Open]], Cell["The spiral curve below is the paper's adopted \
Appendix C reference, rhoSP=-(1-b)^2/2 for 0<=b<1 and zero above saturation. \
The algebra is checked within that ansatz; no quantum correction to the \
spiral is assumed or computed in the paper or here.", "Text"], 
  Cell["2. Regular classical profile and the optimal disk", "Section"], 
  Cell["Equations (8)-(9): beta(0)=pi, beta(R)=0. Shooting uses the regular \
expansion beta=pi+a r+c r^3, c=-a^3/12-a^2/4-b a/8, rather than fixing a \
near-origin value independently of its slope. A bracketed root and \
monotonicity checks select the single-skyrmion branch. Radius optimization \
uses a bounded golden-section search and requires an interior minimum with \
negative energy relative to the ferromagnet.", "Text"], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"profile", "[", RowBox[
           {RowBox[{"bb_", "?", "NumericQ"}], ",", RowBox[{"radius_", "?", 
              "NumericQ"}]}], "]"}], ":=", 
        RowBox[{RowBox[{"profile", "[", RowBox[{"bb", ",", "radius"}], "]"}], 
          "=", RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                 {"r", ",", "y", ",", "a", ",", RowBox[{"eps", "=", 
                    FractionBox["1", SuperscriptBox["10", "5"]]}], ",", "bn", 
                  ",", "rn", ",", "shoot", ",", "end", ",", "lo", ",", "hi", 
                  ",", "slope", ",", "sol", ",", "sample", ",", "rho", ",", 
                  "residual"}], "}"}], ",", RowBox[{RowBox[{"bn", "=", 
                  RowBox[{"N", "[", RowBox[{RowBox[{"Rationalize", "[", 
                        RowBox[{"bb", ",", FractionBox["1", SuperscriptBox[
                          "10", "12"]]}], "]"}], ",", "24"}], "]"}]}], ";", 
                RowBox[{"rn", "=", RowBox[{"N", "[", RowBox[{RowBox[
                       {"Rationalize", "[", RowBox[{"radius", ",", 
                          FractionBox["1", SuperscriptBox["10", "12"]]}], 
                        "]"}], ",", "24"}], "]"}]}], ";", RowBox[
                 {RowBox[{"shoot", "[", RowBox[{"aa_", "?", "NumericQ"}], 
                    "]"}], ":=", RowBox[{"Module", "[", RowBox[
                     {RowBox[{"{", RowBox[{RowBox[{"an", "=", RowBox[
                          {"SetPrecision", "[", RowBox[{"aa", ",", "24"}], 
                          "]"}]}], ",", "cc"}], "}"}], ",", RowBox[
                       {RowBox[{"cc", "=", RowBox[{RowBox[{"-", FractionBox[
                          SuperscriptBox["an", "3"], "12"]}], "-", 
                          FractionBox[SuperscriptBox["an", "2"], "4"], "-", 
                          FractionBox[RowBox[{"bn", " ", "an"}], "8"]}]}], 
                        ";", RowBox[{"NDSolveValue", "[", RowBox[{RowBox[
                          {"{", RowBox[{RowBox[{RowBox[{RowBox[
                          {SuperscriptBox["y", "\[Prime]\[Prime]", 
                          MultilineFunction -> None], "[", "r", "]"}], "+", 
                          FractionBox[RowBox[{SuperscriptBox["y", "\[Prime]", 
                          MultilineFunction -> None], "[", "r", "]"}], "r"], 
                          "-", FractionBox[RowBox[{RowBox[{"Sin", "[", RowBox[
                          {"y", "[", "r", "]"}], "]"}], " ", RowBox[{"Cos", 
                          "[", RowBox[{"y", "[", "r", "]"}], "]"}]}], 
                          SuperscriptBox["r", "2"]], "+", FractionBox[RowBox[
                          {"2", " ", SuperscriptBox[RowBox[{"Sin", "[", 
                          RowBox[{"y", "[", "r", "]"}], "]"}], "2"]}], "r"], 
                          "-", RowBox[{"bn", " ", RowBox[{"Sin", "[", RowBox[
                          {"y", "[", "r", "]"}], "]"}]}]}], "\[Equal]", 
                          "0"}], ",", RowBox[{RowBox[{"y", "[", "eps", "]"}], 
                          "\[Equal]", RowBox[{RowBox[{"N", "[", RowBox[
                          {"\[Pi]", ",", "24"}], "]"}], "+", RowBox[{"an", 
                          " ", "eps"}], "+", RowBox[{"cc", " ", 
                          SuperscriptBox["eps", "3"]}]}]}], ",", RowBox[
                          {RowBox[{SuperscriptBox["y", "\[Prime]", 
                          MultilineFunction -> None], "[", "eps", "]"}], 
                          "\[Equal]", RowBox[{"an", "+", RowBox[{"3", " ", 
                          "cc", " ", SuperscriptBox["eps", "2"]}]}]}]}], 
                          "}"}], ",", "y", ",", RowBox[{"{", RowBox[{"r", 
                          ",", "eps", ",", "rn"}], "}"}], ",", RowBox[
                          {"WorkingPrecision", "\[Rule]", "24"}], ",", 
                          RowBox[{"AccuracyGoal", "\[Rule]", "15"}], ",", 
                          RowBox[{"PrecisionGoal", "\[Rule]", "15"}], ",", 
                          RowBox[{"MaxSteps", "\[Rule]", "100000"}]}], 
                          "]"}]}]}], "]"}]}], ";", RowBox[
                 {RowBox[{"end", "[", RowBox[{"aa_", "?", "NumericQ"}], 
                    "]"}], ":=", RowBox[{RowBox[{"shoot", "[", "aa", "]"}], 
                    "[", "rn", "]"}]}], ";", RowBox[{"lo", "=", RowBox[
                   {"-", RowBox[{"Max", "[", RowBox[{"4", ",", FractionBox[
                         RowBox[{"4", " ", "\[Pi]"}], "rn"]}], "]"}]}]}], 
                ";", RowBox[{"hi", "=", RowBox[{"-", FractionBox["1", 
                     SuperscriptBox["10", "6"]]}]}], ";", RowBox[{"If", "[", 
                  RowBox[{RowBox[{RowBox[{RowBox[{"end", "[", "lo", "]"}], 
                        " ", RowBox[{"end", "[", "hi", "]"}]}], 
                      "\[GreaterEqual]", "0"}], ",", RowBox[{"Return", "[", 
                      RowBox[{"Failure", "[", RowBox[{"\"ShootingBracket\"", 
                          ",", RowBox[{"Association", "[", RowBox[{RowBox[
                          {"\"b\"", "\[Rule]", "bb"}], ",", RowBox[{"\"R\"", 
                          "\[Rule]", "radius"}]}], "]"}]}], "]"}], "]"}]}], 
                  "]"}], ";", RowBox[{"slope", "=", RowBox[{"a", "/.", 
                    "\[VeryThinSpace]", RowBox[{"FindRoot", "[", RowBox[
                       {RowBox[{RowBox[{"end", "[", "a", "]"}], "\[Equal]", 
                          "0"}], ",", RowBox[{"{", RowBox[{"a", ",", "lo", 
                          ",", "hi"}], "}"}], ",", RowBox[{"Method", 
                          "\[Rule]", "\"Brent\""}], ",", RowBox[
                         {"WorkingPrecision", "\[Rule]", "24"}], ",", 
                        RowBox[{"AccuracyGoal", "\[Rule]", "12"}], ",", 
                        RowBox[{"PrecisionGoal", "\[Rule]", "12"}]}], 
                      "]"}]}]}], ";", RowBox[{"sol", "=", RowBox[{"shoot", 
                    "[", "slope", "]"}]}], ";", RowBox[{"sample", "=", 
                  RowBox[{"sol", "/@", RowBox[{"Subdivide", "[", RowBox[
                       {"eps", ",", "rn", ",", "120"}], "]"}]}]}], ";", 
                RowBox[{"residual", "=", RowBox[{"Abs", "[", RowBox[
                     {"sol", "[", "rn", "]"}], "]"}]}], ";", RowBox[
                 {"If", "[", RowBox[{RowBox[{RowBox[{"residual", ">", 
                        FractionBox["1", SuperscriptBox["10", "10"]]}], "||", 
                      RowBox[{RowBox[{"Min", "[", "sample", "]"}], "<", 
                        RowBox[{"-", FractionBox["1", SuperscriptBox["10", 
                          "8"]]}]}], "||", RowBox[{RowBox[{"Max", "[", 
                          "sample", "]"}], ">", RowBox[{"\[Pi]", "+", 
                          FractionBox["1", SuperscriptBox["10", "8"]]}]}], 
                      "||", RowBox[{RowBox[{"Max", "[", RowBox[
                          {"Differences", "[", "sample", "]"}], "]"}], ">", 
                        FractionBox["1", SuperscriptBox["10", "7"]]}]}], ",", 
                    RowBox[{"Return", "[", RowBox[{"Failure", "[", RowBox[
                         {"\"ProfileBranch\"", ",", RowBox[{"Association", 
                          "[", RowBox[{RowBox[{"\"b\"", "\[Rule]", "bb"}], 
                          ",", RowBox[{"\"R\"", "\[Rule]", "radius"}], ",", 
                          RowBox[{"\"BoundaryResidual\"", "\[Rule]", 
                          "residual"}]}], "]"}]}], "]"}], "]"}]}], "]"}], 
                ";", RowBox[{"rho", "=", FractionBox[RowBox[{"2", " ", 
                     RowBox[{"NIntegrate", "[", RowBox[{RowBox[{"r", " ", 
                          RowBox[{"(", RowBox[{RowBox[{FractionBox["1", "2"], 
                          " ", SuperscriptBox[RowBox[{SuperscriptBox["sol", 
                          "\[Prime]", MultilineFunction -> None], "[", "r", 
                          "]"}], "2"]}], "+", FractionBox[SuperscriptBox[
                          RowBox[{"Sin", "[", RowBox[{"sol", "[", "r", "]"}], 
                          "]"}], "2"], RowBox[{"2", " ", SuperscriptBox["r", 
                          "2"]}]], "+", RowBox[{SuperscriptBox["sol", 
                          "\[Prime]", MultilineFunction -> None], "[", "r", 
                          "]"}], "+", FractionBox[RowBox[{"Sin", "[", RowBox[
                          {"2", " ", RowBox[{"sol", "[", "r", "]"}]}], "]"}], 
                          RowBox[{"2", " ", "r"}]], "+", RowBox[{"bn", " ", 
                          RowBox[{"(", RowBox[{"1", "-", RowBox[{"Cos", "[", 
                          RowBox[{"sol", "[", "r", "]"}], "]"}]}], ")"}]}]}], 
                          ")"}]}], ",", RowBox[{"{", RowBox[{"r", ",", "eps", 
                          ",", "rn"}], "}"}], ",", RowBox[
                          {"WorkingPrecision", "\[Rule]", "20"}], ",", 
                         RowBox[{"AccuracyGoal", "\[Rule]", "11"}], ",", 
                         RowBox[{"PrecisionGoal", "\[Rule]", "11"}]}], 
                       "]"}]}], SuperscriptBox["rn", "2"]]}], ";", 
                RowBox[{"Association", "[", RowBox[{RowBox[{"\"b\"", 
                      "\[Rule]", RowBox[{"N", "[", "bb", "]"}]}], ",", 
                    RowBox[{"\"R\"", "\[Rule]", RowBox[{"N", "[", "radius", 
                        "]"}]}], ",", RowBox[{"\"Beta\"", "\[Rule]", "sol"}], 
                    ",", RowBox[{"\"Slope\"", "\[Rule]", "slope"}], ",", 
                    RowBox[{"\"Epsilon\"", "\[Rule]", "eps"}], ",", 
                    RowBox[{"\"Density\"", "\[Rule]", RowBox[{"N", "[", 
                        "rho", "]"}]}], ",", RowBox[{"\"Energy\"", "\[Rule]", 
                      RowBox[{"N", "[", RowBox[{"\[Pi]", " ", SuperscriptBox[
                          "rn", "2"], " ", "rho"}], "]"}]}], ",", RowBox[
                     {"\"BoundaryResidual\"", "\[Rule]", RowBox[{"N", "[", 
                        "residual", "]"}]}]}], "]"}]}]}], "]"}]}]}], ";", 
      RowBox[{RowBox[{"optimal", "[", RowBox[{"bb_", "?", "NumericQ"}], 
          "]"}], ":=", RowBox[{RowBox[{"optimal", "[", "bb", "]"}], "=", 
          RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"r", ",", 
                  "grid", ",", "data", ",", "i", ",", "left", ",", "right", 
                  ",", "answer"}], "}"}], ",", RowBox[{RowBox[{"grid", "=", 
                  RowBox[{"N", "[", RowBox[{"{", RowBox[{"2", ",", "3", ",", 
                        "4", ",", "5", ",", "6", ",", "8", ",", "10", ",", 
                        "12"}], "}"}], "]"}]}], ";", RowBox[{"data", "=", 
                  RowBox[{"Table", "[", RowBox[{RowBox[{"{", RowBox[{"rr", 
                          ",", RowBox[{RowBox[{"profile", "[", RowBox[{"bb", 
                          ",", "rr"}], "]"}], "[", "\"Density\"", "]"}]}], 
                        "}"}], ",", RowBox[{"{", RowBox[{"rr", ",", "grid"}], 
                        "}"}]}], "]"}]}], ";", RowBox[{"i", "=", 
                  RowBox[{"First", "[", RowBox[{"Ordering", "[", RowBox[
                       {RowBox[{"data", "\[LeftDoubleBracket]", RowBox[
                          {"All", ",", "2"}], "\[RightDoubleBracket]"}], ",", 
                        "1"}], "]"}], "]"}]}], ";", RowBox[{"If", "[", 
                  RowBox[{RowBox[{RowBox[{"i", "\[Equal]", "1"}], "||", 
                      RowBox[{"i", "\[Equal]", RowBox[{"Length", "[", "grid", 
                          "]"}]}]}], ",", RowBox[{"Return", "[", RowBox[
                       {"Failure", "[", RowBox[{"\"RadiusBracket\"", ",", 
                          RowBox[{"Association", "[", RowBox[{RowBox[
                          {"\"b\"", "\[Rule]", "bb"}], ",", RowBox[
                          {"\"Scan\"", "\[Rule]", "data"}]}], "]"}]}], "]"}], 
                      "]"}]}], "]"}], ";", RowBox[{"If", "[", RowBox[
                   {RowBox[{RowBox[{"Min", "[", RowBox[{"data", 
                          "\[LeftDoubleBracket]", RowBox[{"All", ",", "2"}], 
                          "\[RightDoubleBracket]"}], "]"}], 
                      "\[GreaterEqual]", "0"}], ",", RowBox[{"Return", "[", 
                      RowBox[{"Failure", "[", RowBox[{"\"FerromagnetLower\"", 
                          ",", RowBox[{"Association", "[", RowBox[{"\"b\"", 
                          "\[Rule]", "bb"}], "]"}]}], "]"}], "]"}]}], "]"}], 
                ";", RowBox[{"left", "=", RowBox[{"grid", 
                    "\[LeftDoubleBracket]", RowBox[{"i", "-", "1"}], 
                    "\[RightDoubleBracket]"}]}], ";", RowBox[{"right", "=", 
                  RowBox[{"grid", "\[LeftDoubleBracket]", RowBox[{"i", "+", 
                      "1"}], "\[RightDoubleBracket]"}]}], ";", 
                RowBox[{"answer", "=", RowBox[{"goldenMinimum", "[", 
                    RowBox[{RowBox[{"Function", "[", RowBox[{RowBox[{"{", 
                          "rr", "}"}], ",", RowBox[{RowBox[{"profile", "[", 
                          RowBox[{"bb", ",", "rr"}], "]"}], "[", 
                          "\"Density\"", "]"}]}], "]"}], ",", "left", ",", 
                      "right", ",", "0.001`"}], "]"}]}], ";", RowBox[
                 {"profile", "[", RowBox[{"bb", ",", "answer"}], "]"}]}]}], 
            "]"}]}]}], ";", RowBox[{RowBox[{"goldenMinimum", "[", 
          RowBox[{"fn_", ",", "aa_", ",", "bb_", ",", "tol_"}], "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"left", "=", RowBox[{"N", "[", "aa", 
                    "]"}]}], ",", RowBox[{"right", "=", RowBox[{"N", "[", 
                    "bb", "]"}]}], ",", RowBox[{"ratio", "=", RowBox[
                   {FractionBox["1", "2"], " ", RowBox[{"(", RowBox[
                       {SqrtBox["5.`"], "-", "1"}], ")"}]}]}], ",", "x1", 
                ",", "x2", ",", "f1", ",", "f2"}], "}"}], ",", 
            RowBox[{RowBox[{"x1", "=", RowBox[{"right", "-", RowBox[
                   {"ratio", " ", RowBox[{"(", RowBox[{"right", "-", 
                        "left"}], ")"}]}]}]}], ";", RowBox[{"x2", "=", 
                RowBox[{"left", "+", RowBox[{"ratio", " ", RowBox[{"(", 
                      RowBox[{"right", "-", "left"}], ")"}]}]}]}], ";", 
              RowBox[{"f1", "=", RowBox[{"fn", "[", "x1", "]"}]}], ";", 
              RowBox[{"f2", "=", RowBox[{"fn", "[", "x2", "]"}]}], ";", 
              RowBox[{"While", "[", RowBox[{RowBox[{RowBox[{"right", "-", 
                      "left"}], ">", "tol"}], ",", RowBox[{"If", "[", 
                    RowBox[{RowBox[{"f1", "<", "f2"}], ",", RowBox[
                       {RowBox[{"right", "=", "x2"}], ";", RowBox[{"x2", "=", 
                          "x1"}], ";", RowBox[{"f2", "=", "f1"}], ";", 
                        RowBox[{"x1", "=", RowBox[{"right", "-", RowBox[
                          {"ratio", " ", RowBox[{"(", RowBox[{"right", "-", 
                          "left"}], ")"}]}]}]}], ";", RowBox[{"f1", "=", 
                          RowBox[{"fn", "[", "x1", "]"}]}]}], ",", RowBox[
                       {RowBox[{"left", "=", "x1"}], ";", RowBox[{"x1", "=", 
                          "x2"}], ";", RowBox[{"f1", "=", "f2"}], ";", 
                        RowBox[{"x2", "=", RowBox[{"left", "+", RowBox[
                          {"ratio", " ", RowBox[{"(", RowBox[{"right", "-", 
                          "left"}], ")"}]}]}]}], ";", RowBox[{"f2", "=", 
