Notebook[{Cell["Skyrmion crystals: complete calculations", "Title"], 
  Cell["D. N. Aristov and A. V. Tsypilnikov | arXiv:1705.00196v1 | \
consolidated Mathematica notebook", "Subtitle"], 
  Cell["Source: Magnon spectrum in two- and three-dimensional skyrmion \
crystals (2017), https://arxiv.org/abs/1705.00196v1. Retrieved from Zotero \
item 3YT3JK4F, PDF attachment UBK5Y3VM. This notebook computes its own \
profiles, matrices, scans and figures; it does not load the historical \
notebooks or external data. Evaluate from the first cell in a fresh kernel. \
All computation is serial and uses built-in Wolfram Language functions. The \
full serial run took about 27 minutes on this machine; saved outputs can be \
inspected without rerunning.", "Text"], 
  Cell["1. Conventions, parameters and equation checks", "Section"], 
  Cell["Lengths are in C/D; spin-wave energies in D^2/C; b=BC/(s D^2). C=D=1 \
in the dimensionless solver, anisotropy is zero. Classical density rhoC is \
the coefficient after division by s; the normalized corrected density is \
rhoC+rhoQ/s. The ferromagnetic reference energy is subtracted. The paper \
orientation dy n cross dx n gives topological charge +1; reversing the \
derivatives gives -1.", "Text"], 
  Cell[CellGroupData[
    {Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", "\"Global`*\"", "]"}], 
         ";", RowBox[{"$HistoryLength", "=", "0"}], ";", 
         RowBox[{"nRadial", "=", "40"}], ";", RowBox[{"nQuadrature", "=", 
           "320"}], ";", RowBox[{"mCutoff", "=", "8"}], ";", 
         RowBox[{"referenceField", "=", "0.6`"}], ";", 
         RowBox[{"spinValue", "=", FractionBox["1", "2"]}], ";", 
         TagBox[GridBox[{{"\"Parameter\"", "\"Value\""}, 
            {"\"b\"", "referenceField"}, 
            {"\"Radial Bessel functions per component\"", "nRadial"}, 
            {"\"Gauss-Legendre nodes\"", "nQuadrature"}, 
            {"\"Angular cutoff for quantum sums\"", "mCutoff"}, 
            {"\"Spin for illustrative quantum shift\"", "spinValue"}, 
            {"\"Profile precision / ODE goals\"", 
             "\"24 digits / 15 digits\""}, {"\"Origin cutoff\"", 
             FractionBox["1", SuperscriptBox["10", "5"]]}}, 
           GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, 
           GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
           GridBoxItemSize -> {"Columns" -> {{Automatic}}, 
             "Rows" -> {{Automatic}}}], "Grid"]}]], "Input", 
      CellLabel -> "In[1]:=", CellTags -> {"parameters"}], 
     Cell[BoxData[TagBox[GridBox[{{"\"Parameter\"", "\"Value\""}, 
          {"\"b\"", "0.6`"}, {"\"Radial Bessel functions per component\"", 
           "40"}, {"\"Gauss-Legendre nodes\"", "320"}, 
          {"\"Angular cutoff for quantum sums\"", "8"}, 
          {"\"Spin for illustrative quantum shift\"", FractionBox["1", "2"]}, 
          {"\"Profile precision / ODE goals\"", "\"24 digits / 15 digits\""}, 
          {"\"Origin cutoff\"", FractionBox["1", "100000"]}}, 
         GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, 
         GridBoxFrame -> {"Columns" -> {{True}}, "Rows" -> {{True}}}, 
         GridBoxItemSize -> {"Columns" -> {{Automatic}}, 
           "Rows" -> {{Automatic}}}], "Grid"]], "Output"]}, Open]], 
  Cell[CellGroupData[
    {Cell[BoxData[RowBox[{"Module", "[", 
         RowBox[{RowBox[{"{", RowBox[{"rad", ",", "ang", ",", "beta", ",", 
               "alpha", ",", "spinUnit", ",", "dx", ",", "dy", ",", 
               "exchangeComputed", ",", "curlComputed", ",", 
               "topologicalComputed", ",", "exchangeExpected", ",", 
               "curlExpected", ",", "topoExpected", ",", "theta", ",", 
               "slope", ",", "curvature", ",", "field", ",", "winding", ",", 
               "angular", ",", "lagrangian", ",", "eulerComputed", ",", 
               "eulerExpected", ",", "fEq11", ",", "gEq11", ",", 
               "potential0", ",", "potential1", ",", "gB3", ",", "gauge", 
               ",", "block", ",", "gaugeResidual", ",", "checks", ",", 
               "assumptions"}], "}"}], ",", RowBox[
            {RowBox[{"assumptions", "=", RowBox[{RowBox[{"rad", ">", "0"}], 
                 "&&", RowBox[{RowBox[{"{", RowBox[{"theta", ",", "slope", 
                       ",", "curvature", ",", "field", ",", "angular"}], 
                     "}"}], "\[Element]", TemplateBox[{}, "Reals"]}]}]}], 
             ";", RowBox[{"spinUnit", "=", RowBox[{"{", RowBox[
                  {RowBox[{RowBox[{"Sin", "[", RowBox[{"beta", "[", "rad", 
                         "]"}], "]"}], " ", RowBox[{"Cos", "[", RowBox[
                        {"alpha", "[", "ang", "]"}], "]"}]}], ",", 
                   RowBox[{RowBox[{"Sin", "[", RowBox[{"beta", "[", "rad", 
                         "]"}], "]"}], " ", RowBox[{"Sin", "[", RowBox[
                        {"alpha", "[", "ang", "]"}], "]"}]}], ",", 
                   RowBox[{"Cos", "[", RowBox[{"beta", "[", "rad", "]"}], 
                     "]"}]}], "}"}]}], ";", RowBox[{RowBox[{"dx", "[", 
                 "expr_", "]"}], ":=", RowBox[{RowBox[{RowBox[{"Cos", "[", 
                     "ang", "]"}], " ", RowBox[{SubscriptBox["\[PartialD]", 
                      RowBox[{"rad"}]], "expr"}]}], "-", FractionBox[
                  RowBox[{RowBox[{"Sin", "[", "ang", "]"}], " ", RowBox[
                     {SubscriptBox["\[PartialD]", RowBox[{"ang"}]], 
                      "expr"}]}], "rad"]}]}], ";", RowBox[
              {RowBox[{"dy", "[", "expr_", "]"}], ":=", RowBox[
                {RowBox[{RowBox[{"Sin", "[", "ang", "]"}], " ", RowBox[
                    {SubscriptBox["\[PartialD]", RowBox[{"rad"}]], 
                     "expr"}]}], "+", FractionBox[RowBox[{RowBox[{"Cos", "[", 
                      "ang", "]"}], " ", RowBox[{SubscriptBox["\[PartialD]", 
                       RowBox[{"ang"}]], "expr"}]}], "rad"]}]}], ";", 
             RowBox[{"exchangeComputed", "=", RowBox[{RowBox[
                  {RowBox[{"dx", "[", "spinUnit", "]"}], ".", RowBox[
                    {"dx", "[", "spinUnit", "]"}]}], "+", RowBox[
                  {RowBox[{"dy", "[", "spinUnit", "]"}], ".", RowBox[
                    {"dy", "[", "spinUnit", "]"}]}]}]}], ";", 
             RowBox[{"curlComputed", "=", RowBox[{"spinUnit", ".", 
                 RowBox[{"{", RowBox[{RowBox[{"dy", "[", RowBox[{"spinUnit", 
                         "\[LeftDoubleBracket]", "3", 
                         "\[RightDoubleBracket]"}], "]"}], ",", RowBox[
                      {"-", RowBox[{"dx", "[", RowBox[{"spinUnit", 
                          "\[LeftDoubleBracket]", "3", 
                          "\[RightDoubleBracket]"}], "]"}]}], ",", RowBox[
                      {RowBox[{"dx", "[", RowBox[{"spinUnit", 
                          "\[LeftDoubleBracket]", "2", 
                          "\[RightDoubleBracket]"}], "]"}], "-", RowBox[
                        {"dy", "[", RowBox[{"spinUnit", 
                          "\[LeftDoubleBracket]", "1", 
                          "\[RightDoubleBracket]"}], "]"}]}]}], "}"}]}]}], 
             ";", RowBox[{"topologicalComputed", "=", RowBox[{"rad", " ", 
                 RowBox[{"spinUnit", ".", RowBox[{RowBox[{"dy", "[", 
                       "spinUnit", "]"}], "\[Cross]", RowBox[{"dx", "[", 
                       "spinUnit", "]"}]}]}]}]}], ";", 
             RowBox[{"exchangeExpected", "=", RowBox[{SuperscriptBox[
                  RowBox[{SuperscriptBox["beta", "\[Prime]", 
                     MultilineFunction -> None], "[", "rad", "]"}], "2"], 
                 "+", FractionBox[RowBox[{SuperscriptBox[RowBox[{"Sin", "[", 
                       RowBox[{"beta", "[", "rad", "]"}], "]"}], "2"], " ", 
                    SuperscriptBox[RowBox[{SuperscriptBox["alpha", 
                        "\[Prime]", MultilineFunction -> None], "[", "ang", 
                       "]"}], "2"]}], SuperscriptBox["rad", "2"]]}]}], ";", 
             RowBox[{"curlExpected", "=", RowBox[{RowBox[{"Sin", "[", 
                   RowBox[{RowBox[{"alpha", "[", "ang", "]"}], "-", "ang"}], 
                   "]"}], " ", RowBox[{"(", RowBox[{RowBox[{SuperscriptBox[
                        "beta", "\[Prime]", MultilineFunction -> None], "[", 
                       "rad", "]"}], "+", FractionBox[RowBox[{RowBox[{"Sin", 
                          "[", RowBox[{"2", " ", RowBox[{"beta", "[", "rad", 
                          "]"}]}], "]"}], " ", RowBox[{SuperscriptBox[
                          "alpha", "\[Prime]", MultilineFunction -> None], 
                          "[", "ang", "]"}]}], RowBox[{"2", " ", "rad"}]]}], 
                   ")"}]}]}], ";", RowBox[{"topoExpected", "=", RowBox[
                {RowBox[{"-", RowBox[{"Sin", "[", RowBox[{"beta", "[", "rad", 
                       "]"}], "]"}]}], " ", RowBox[{SuperscriptBox["beta", 
                    "\[Prime]", MultilineFunction -> None], "[", "rad", 
                   "]"}], " ", RowBox[{SuperscriptBox["alpha", "\[Prime]", 
                    MultilineFunction -> None], "[", "ang", "]"}]}]}], ";", 
             RowBox[{"lagrangian", "=", RowBox[{FractionBox[RowBox[
                   {"rad", " ", SuperscriptBox["slope", "2"]}], "2"], "+", 
                 FractionBox[SuperscriptBox[RowBox[{"Sin", "[", "theta", 
                     "]"}], "2"], RowBox[{"2", " ", "rad"}]], "+", 
                 RowBox[{"rad", " ", "slope"}], "+", RowBox[{FractionBox["1", 
                    "2"], " ", RowBox[{"Sin", "[", RowBox[{"2", " ", 
                       "theta"}], "]"}]}], "-", RowBox[{"field", " ", "rad", 
                   " ", RowBox[{"(", RowBox[{RowBox[{"Cos", "[", "theta", 
                         "]"}], "-", "1"}], ")"}]}]}]}], ";", 
             RowBox[{"eulerComputed", "=", FractionBox[RowBox[
                 {RowBox[{SubscriptBox["\[PartialD]", RowBox[{"rad"}]], 
                    RowBox[{SubscriptBox["\[PartialD]", RowBox[{"slope"}]], 
                      "lagrangian"}]}], "+", RowBox[{"slope", " ", 
                    RowBox[{SubscriptBox["\[PartialD]", RowBox[{"theta"}]], 
                      RowBox[{SubscriptBox["\[PartialD]", RowBox[{"slope"}]], 
                        "lagrangian"}]}]}], "+", RowBox[{"curvature", " ", 
                    RowBox[{SubscriptBox["\[PartialD]", RowBox[{"slope"}]], 
                      RowBox[{SubscriptBox["\[PartialD]", RowBox[{"slope"}]], 
                        "lagrangian"}]}]}], "-", RowBox[{SubscriptBox[
                     "\[PartialD]", RowBox[{"theta"}]], "lagrangian"}]}], 
                "rad"]}], ";", RowBox[{"eulerExpected", "=", RowBox[
                {"curvature", "+", FractionBox["slope", "rad"], "-", 
                 FractionBox[RowBox[{RowBox[{"Sin", "[", "theta", "]"}], " ", 
                    RowBox[{"Cos", "[", "theta", "]"}]}], SuperscriptBox[
                   "rad", "2"]], "+", FractionBox[RowBox[{"2", " ", 
                    SuperscriptBox[RowBox[{"Sin", "[", "theta", "]"}], 
                     "2"]}], "rad"], "-", RowBox[{"field", " ", RowBox[
                    {"Sin", "[", "theta", "]"}]}]}]}], ";", 
             RowBox[{"fEq11", "=", RowBox[{FractionBox[SuperscriptBox[
                   "angular", "2"], SuperscriptBox["rad", "2"]], "+", 
                 FractionBox[RowBox[{"1", "+", RowBox[{"3", " ", RowBox[
                       {"Cos", "[", RowBox[{"2", " ", "theta"}], "]"}]}]}], 
                  RowBox[{"4", " ", SuperscriptBox["rad", "2"]}]], "-", 
                 FractionBox[RowBox[{"2", " ", "angular", " ", RowBox[
                     {"Cos", "[", "theta", "]"}]}], SuperscriptBox["rad", 
                   "2"]], "-", FractionBox[SuperscriptBox["slope", "2"], 
                  "2"], "-", FractionBox[RowBox[{"3", " ", RowBox[{"Sin", 
                      "[", RowBox[{"2", " ", "theta"}], "]"}]}], 
                  RowBox[{"2", " ", "rad"}]], "+", FractionBox[RowBox[
                   {"2", " ", "angular", " ", RowBox[{"Sin", "[", "theta", 
                      "]"}]}], "rad"], "-", "slope", "+", RowBox[{"field", 
                   " ", RowBox[{"Cos", "[", "theta", "]"}]}]}]}], ";", 
             RowBox[{"gEq11", "=", RowBox[{RowBox[{FractionBox["1", "2"], 
                   " ", RowBox[{"(", RowBox[{RowBox[{"-", FractionBox[
                          SuperscriptBox[RowBox[{"Sin", "[", "theta", "]"}], 
                          "2"], SuperscriptBox["rad", "2"]]}], "+", 
                       SuperscriptBox["slope", "2"]}], ")"}]}], "+", "slope", 
                 "-", FractionBox[RowBox[{"Sin", "[", RowBox[{"2", " ", 
                      "theta"}], "]"}], RowBox[{"2", " ", "rad"}]]}]}], ";", 
             RowBox[{"potential0", "=", RowBox[{RowBox[{RowBox[{"-", 
                     FractionBox["1", "2"]}], " ", RowBox[{"(", RowBox[
                      {FractionBox[RowBox[{"3", " ", SuperscriptBox[RowBox[
                          {"Sin", "[", "theta", "]"}], "2"]}], SuperscriptBox[
                         "rad", "2"]], "+", SuperscriptBox["slope", "2"]}], 
                     ")"}]}], "-", FractionBox[RowBox[{"3", " ", RowBox[
                     {"Sin", "[", RowBox[{"2", " ", "theta"}], "]"}]}], 
                  RowBox[{"2", " ", "rad"}]], "-", "slope", "+", 
                 RowBox[{"field", " ", RowBox[{"Cos", "[", "theta", 
                     "]"}]}]}]}], ";", RowBox[{"potential1", "=", FractionBox[
                RowBox[{"2", " ", RowBox[{"(", RowBox[{RowBox[{"Sin", "[", 
                        "theta", "]"}], "-", FractionBox[RowBox[{RowBox[
                          {"Cos", "[", "theta", "]"}], "+", "1"}], "rad"]}], 
                    ")"}]}], "rad"]}], ";", RowBox[{"gB3", "=", RowBox[
                {RowBox[{FractionBox["1", "2"], " ", RowBox[{"(", RowBox[
                      {FractionBox[SuperscriptBox[RowBox[{"Sin", "[", 
                          "theta", "]"}], "2"], SuperscriptBox["rad", "2"]], 
                       "-", SuperscriptBox["slope", "2"]}], ")"}]}], "+", 
                 FractionBox[RowBox[{"Sin", "[", RowBox[{"2", " ", "theta"}], 
                    "]"}], RowBox[{"2", " ", "rad"}]], "-", "slope"}]}], ";", 
             RowBox[{"gauge", "=", RowBox[{"DiagonalMatrix", "[", 
                 RowBox[{"{", RowBox[{"1", ",", RowBox[{"-", "1"}]}], "}"}], 
                 "]"}]}], ";", RowBox[{RowBox[{"block", "[", "pair_", "]"}], 
               ":=", RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"fEq11", ",", 
                       "pair"}], "}"}], ",", RowBox[{"{", RowBox[
                      {RowBox[{"-", "pair"}], ",", RowBox[{"-", RowBox[
                          {"(", RowBox[{"fEq11", "/.", "\[VeryThinSpace]", 
                          RowBox[{"angular", "\[Rule]", RowBox[{"-", 
                          "angular"}]}]}], ")"}]}]}], "}"}]}], "}"}]}], ";", 
             RowBox[{"gaugeResidual", "=", RowBox[{"Simplify", "[", 
                 RowBox[{RowBox[{"gauge", ".", RowBox[{"block", "[", "gEq11", 
                       "]"}], ".", "gauge"}], "-", RowBox[{"block", "[", 
                     "gB3", "]"}]}], "]"}]}], ";", RowBox[{"checks", "=", 
               RowBox[{"{", RowBox[{RowBox[{"{", RowBox[
                      {"\"Eq. (7): exchange density\"", ",", RowBox[
                        {"FullSimplify", "[", RowBox[{"exchangeComputed", 
                          "-", "exchangeExpected"}], "]"}]}], "}"}], ",", 
                   RowBox[{"{", RowBox[{"\"Eq. (7): bulk DMI density\"", ",", 
                       RowBox[{"FullSimplify", "[", RowBox[{"curlComputed", 
                          "-", "curlExpected"}], "]"}]}], "}"}], ",", 
                   RowBox[{"{", RowBox[
                      {"\"Eq. (5): paper orientation dy n cross dx n\"", ",", 
                       RowBox[{"FullSimplify", "[", RowBox[
                          {"topologicalComputed", "-", "topoExpected"}], 
                         "]"}]}], "}"}], ",", RowBox[{"{", RowBox[
                      {"\"Eq. (5): charge / winding, beta: pi to 0\"", ",", 
                       RowBox[{"Simplify", "[", RowBox[{FractionBox["1", 
                          "2"], " ", RowBox[{"(", RowBox[{RowBox[{"Cos", "[", 
                          "0", "]"}], "-", RowBox[{"Cos", "[", "\[Pi]", 
                          "]"}]}], ")"}]}], "]"}]}], "}"}], ",", RowBox[
                    {"{", RowBox[
                      {"\"Eq. (9): variational equation from Eq. (8)\"", ",", 
                       RowBox[{"FullSimplify", "[", RowBox[{RowBox[
                          {"eulerComputed", "-", "eulerExpected"}], ",", 
                          "assumptions"}], "]"}]}], "}"}], ",", RowBox[
                    {"{", RowBox[
                      {"\"Eq. (11) F vs. B4, including (m+1)^2 kinetic \
term\"", ",", RowBox[{"FullSimplify", "[", RowBox[{RowBox[{"fEq11", "-", 
                          RowBox[{"(", RowBox[{FractionBox[SuperscriptBox[
                          RowBox[{"(", RowBox[{"angular", "+", "1"}], ")"}], 
                          "2"], SuperscriptBox["rad", "2"]], "+", 
                          "potential0", "+", RowBox[{"angular", " ", 
                          "potential1"}]}], ")"}]}], ",", "assumptions"}], 
                         "]"}]}], "}"}], ",", RowBox[{"{", RowBox[
                      {"\"Printed Eq. (11) G plus printed B3 G\"", ",", 
                       RowBox[{"FullSimplify", "[", RowBox[{RowBox[{"gEq11", 
                          "+", "gB3"}], ",", "assumptions"}], "]"}]}], "}"}], 
                   ",", RowBox[{"{", RowBox[
                      {"\"Pairing sign changes by diag(1,-1) Nambu gauge\"", 
                       ",", "gaugeResidual"}], "}"}]}], "}"}]}], ";", 
             RowBox[{"Grid", "[", RowBox[{RowBox[{"Prepend", "[", 
                   RowBox[{"checks", ",", RowBox[{"{", RowBox[
                        {"\"Independent algebraic identity\"", ",", 
                         "\"Residual (zero) or result\""}], "}"}]}], "]"}], 
                 ",", RowBox[{"Frame", "\[Rule]", "All"}], ",", 
                 RowBox[{"Alignment", "\[Rule]", "Left"}], ",", 
                 RowBox[{"Background", "\[Rule]", RowBox[{"{", RowBox[
                      {"None", ",", RowBox[{"{", RowBox[{"LightGray", ",", 
                          "None"}], "}"}]}], "}"}]}]}], "]"}]}]}], "]"}]], 
      "Input", CellLabel -> "In[2]:=", CellTags -> {"symbolic-identities"}], 
     Cell[BoxData[TagBox[GridBox[{{"\"Independent algebraic identity\"", 
           "\"Residual (zero) or result\""}, 
          {"\"Eq. (7): exchange density\"", "0"}, 
          {"\"Eq. (7): bulk DMI density\"", "0"}, 
          {"\"Eq. (5): paper orientation dy n cross dx n\"", "0"}, 
          {"\"Eq. (5): charge / winding, beta: pi to 0\"", "1"}, 
          {"\"Eq. (9): variational equation from Eq. (8)\"", "0"}, 
          {"\"Eq. (11) F vs. B4, including (m+1)^2 kinetic term\"", "0"}, 
          {"\"Printed Eq. (11) G plus printed B3 G\"", "0"}, 
          {"\"Pairing sign changes by diag(1,-1) Nambu gauge\"", 
           RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", "0"}], "}"}], 
               ",", RowBox[{"{", RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}}, 
         GridBoxAlignment -> {"Columns" -> {{Left}}}, AutoDelete -> False, 
         GridBoxBackground -> {"Columns" -> {{None}}, 
           "Rows" -> {GrayLevel[0.85], None}}, GridBoxFrame -> 
          {"Columns" -> {{True}}, "Rows" -> {{True}}}, GridBoxItemSize -> 
          {"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}], "Grid"]], 
      "Output"]}, Open]], Cell["The anomalous term G in main-text Eq. (11) is \
the negative of Appendix B Eq. (B3). We use B3 throughout; diag(1,-1) in \
Nambu space relates the two conventions and leaves energies unchanged. The \
two component Bessel orders are |m+1| and |1-m|. The off-diagonal coupling \
between these different bases is a full matrix, with its transpose in the \
lower block.", "Text"], 
  Cell[CellGroupData[
    {Cell[BoxData[RowBox[{"Module", "[", 
         RowBox[{RowBox[{"{", RowBox[{"coord", ",", "azimuth", ",", "polar", 
               ",", "rotZ", ",", "rotY", ",", "localRotation", ",", 
               "localSpin", ",", "connection1", ",", "connection2", ",", 
               "explicitConnection", ",", "realAngles", ",", "rows"}], "}"}], 
           ",", RowBox[{RowBox[{RowBox[{"rotZ", "[", "value_", "]"}], ":=", 
               RowBox[{"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"Cos", "[", 
                         "value", "]"}], ",", RowBox[{"-", RowBox[{"Sin", 
                          "[", "value", "]"}]}], ",", "0"}], "}"}], ",", 
                   RowBox[{"{", RowBox[{RowBox[{"Sin", "[", "value", "]"}], 
                       ",", RowBox[{"Cos", "[", "value", "]"}], ",", "0"}], 
                     "}"}], ",", RowBox[{"{", RowBox[{"0", ",", "0", ",", 
                       "1"}], "}"}]}], "}"}]}], ";", 
             RowBox[{RowBox[{"rotY", "[", "value_", "]"}], ":=", RowBox[
                {"{", RowBox[{RowBox[{"{", RowBox[{RowBox[{"Cos", "[", 
                         "value", "]"}], ",", "0", ",", RowBox[{"Sin", "[", 
                         "value", "]"}]}], "}"}], ",", RowBox[{"{", 
                     RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
                   RowBox[{"{", RowBox[{RowBox[{"-", RowBox[{"Sin", "[", 
                          "value", "]"}]}], ",", "0", ",", RowBox[{"Cos", 
                         "[", "value", "]"}]}], "}"}]}], "}"}]}], ";", 
             RowBox[{"localRotation", "=", RowBox[{RowBox[{"rotZ", "[", 
                   RowBox[{"azimuth", "[", "coord", "]"}], "]"}], ".", 
                 RowBox[{"rotY", "[", RowBox[{"polar", "[", "coord", "]"}], 
                   "]"}]}]}], ";", RowBox[{"localSpin", "=", RowBox[
                {"{", RowBox[{RowBox[{RowBox[{"Sin", "[", RowBox[{"polar", 
                         "[", "coord", "]"}], "]"}], " ", RowBox[{"Cos", "[", 
                       RowBox[{"azimuth", "[", "coord", "]"}], "]"}]}], ",", 
                   RowBox[{RowBox[{"Sin", "[", RowBox[{"polar", "[", "coord", 
                         "]"}], "]"}], " ", RowBox[{"Sin", "[", RowBox[
                        {"azimuth", "[", "coord", "]"}], "]"}]}], ",", 
                   RowBox[{"Cos", "[", RowBox[{"polar", "[", "coord", "]"}], 
                     "]"}]}], "}"}]}], ";", RowBox[{"connection1", "=", 
               RowBox[{TemplateBox[{"localRotation"}, "Transpose", 
                  SyntaxForm -> SuperscriptBox], ".", RowBox[{SubscriptBox[
                    "\[PartialD]", RowBox[{"coord"}]], "localRotation"}]}]}], 
             ";", RowBox[{"connection2", "=", RowBox[{TemplateBox[
                  {"localRotation"}, "Transpose", SyntaxForm -> 
                   SuperscriptBox], ".", RowBox[{SubscriptBox["\[PartialD]", 
                    RowBox[{RowBox[{"{", RowBox[{"coord", ",", "2"}], 
                        "}"}]}]], "localRotation"}]}]}], ";", 
             RowBox[{"explicitConnection", "=", RowBox[{"{", RowBox[
                  {RowBox[{"{", RowBox[{"0", ",", RowBox[{RowBox[{"-", 
                          RowBox[{SuperscriptBox["azimuth", "\[Prime]", 
                          MultilineFunction -> None], "[", "coord", "]"}]}], 
                         " ", RowBox[{"Cos", "[", RowBox[{"polar", "[", 
                          "coord", "]"}], "]"}]}], ",", RowBox[
                        {SuperscriptBox["polar", "\[Prime]", 
                          MultilineFunction -> None], "[", "coord", "]"}]}], 
                     "}"}], ",", RowBox[{"{", RowBox[{RowBox[{RowBox[
                          {SuperscriptBox["azimuth", "\[Prime]", 
                          MultilineFunction -> None], "[", "coord", "]"}], 
                         " ", RowBox[{"Cos", "[", RowBox[{"polar", "[", 
                          "coord", "]"}], "]"}]}], ",", "0", ",", RowBox[
                        {RowBox[{SuperscriptBox["azimuth", "\[Prime]", 
                          MultilineFunction -> None], "[", "coord", "]"}], 
                         " ", RowBox[{"Sin", "[", RowBox[{"polar", "[", 
                          "coord", "]"}], "]"}]}]}], "}"}], ",", RowBox[
                    {"{", RowBox[{RowBox[{"-", RowBox[{SuperscriptBox[
                          "polar", "\[Prime]", MultilineFunction -> None], 
                          "[", "coord", "]"}]}], ",", RowBox[{RowBox[{"-", 
                          RowBox[{SuperscriptBox["azimuth", "\[Prime]", 
                          MultilineFunction -> None], "[", "coord", "]"}]}], 
                         " ", RowBox[{"Sin", "[", RowBox[{"polar", "[", 
                          "coord", "]"}], "]"}]}], ",", "0"}], "}"}]}], 
                 "}"}]}], ";", RowBox[{"realAngles", "=", RowBox[
                {RowBox[{"{", RowBox[{RowBox[{"azimuth", "[", "coord", "]"}], 
                     ",", RowBox[{"polar", "[", "coord", "]"}]}], "}"}], 
                 "\[Element]", TemplateBox[{}, "Reals"]}]}], ";", 
             RowBox[{"rows", "=", RowBox[{"{", RowBox[{RowBox[{"{", 
                     RowBox[{"\"U^T U = identity\"", ",", RowBox[
                        {"FullSimplify", "[", RowBox[{RowBox[{RowBox[
                          {TemplateBox[{"localRotation"}, "Transpose", 
                          SyntaxForm -> SuperscriptBox], ".", 
                          "localRotation"}], "-", RowBox[{"IdentityMatrix", 
                          "[", "3", "]"}]}], ",", "realAngles"}], "]"}]}], 
                     "}"}], ",", RowBox[{"{", RowBox[
                      {"\"U e3 = m/s, gamma=0 as in the paper\"", ",", 
                       RowBox[{"FullSimplify", "[", RowBox[{RowBox[
                          {"localRotation", ".", RowBox[{"{", RowBox[{"0", 
                          ",", "0", ",", "1"}], "}"}]}], "-", "localSpin"}], 
                         "]"}]}], "}"}], ",", RowBox[{"{", RowBox[
                      {"\"A2: chi1 = U^T partial U\"", ",", RowBox[
                        {"FullSimplify", "[", RowBox[{"connection1", "-", 
