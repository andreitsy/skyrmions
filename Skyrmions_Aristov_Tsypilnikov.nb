                          {"1", ",", "1"}], "\[RightDoubleBracket]"}]}], 
                          ")"}]}], RowBox[{RowBox[{"pp", 
                          "\[LeftDoubleBracket]", RowBox[{"2", ",", "2"}], 
                          "\[RightDoubleBracket]"}], "-", RowBox[{"pp", 
                          "\[LeftDoubleBracket]", RowBox[{"1", ",", "2"}], 
                          "\[RightDoubleBracket]"}]}]]}]}], "]"}]}], "]"}]}], 
                         ";", RowBox[{"{", RowBox[{"bb", ",", "m", ",", 
