  Cell["5. Boundary matching and lattice magnon bands", "Section"], 
  Cell["Section III: transform the radial spinor to sqrt(r) psi and freeze \
the full 2x2 operator at R. The -1/(4R^2) radial transformation term is \
retained. Diagonalize M-tau3 epsilon to find positive decay rates kappa_i; \
fit the boundary derivative to the two sinh solutions and verify the spinor \
on an independent outer interval. Non-evanescent channels explicitly reject \
the hopping estimate. The area equality gives ell/R=sqrt(2 \
pi/sqrt(3))=1.9046256, correcting the printed decimal 1.94. Onsite energy is \
Edisc+delta/2 and t=(-1)^m delta/2; gamma(k) is Eq. (21). Negative band \
bottoms remain visible.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{RowBox[{"latticeSpacing", "[", 
          RowBox[{"radius_", "?", "NumericQ"}], "]"}], ":=", 
        RowBox[{SqrtBox[FractionBox[RowBox[{"2", " ", "\[Pi]"}], 
            SqrtBox["3"]]], " ", "radius"}]}], ";", 
      RowBox[{RowBox[{"gammaHex", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"kx_", "?", "NumericQ"}], ",", 
                RowBox[{"ky_", "?", "NumericQ"}]}], "}"}], ",", 
            RowBox[{"ell_", "?", "NumericQ"}]}], "]"}], ":=", 
        RowBox[{FractionBox["1", "3"], " ", RowBox[
           {"(", RowBox[{RowBox[{"Cos", "[", RowBox[{"kx", " ", "ell"}], 
                "]"}], "+", RowBox[{"2", " ", RowBox[{"Cos", "[", FractionBox[
                   RowBox[{"kx", " ", "ell"}], "2"], "]"}], " ", 
                RowBox[{"Cos", "[", RowBox[{FractionBox["1", "2"], " ", 
                    SqrtBox["3"], " ", "ky", " ", "ell"}], "]"}]}]}], 
            ")"}]}]}], ";", RowBox[{RowBox[{"edgeSplit", "[", 
          RowBox[{"p_Association", ",", "m_Integer", ",", 
            RowBox[{"n_Integer", ":", "40"}], ",", RowBox[{"q_Integer", ":", 
              "512"}], ",", RowBox[{"fitFraction_", ":", "0.1`"}]}], "]"}], 
        ":=", RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"radius", "=", RowBox[{"p", "[", 
                    "\"R\"", "]"}]}], ",", RowBox[{"bb", "=", RowBox[
                   {"p", "[", "\"b\"", "]"}]}], ",", RowBox[{"beta", "=", 
                  RowBox[{"p", "[", "\"Beta\"", "]"}]}], ",", "states", ",", 
                "state", ",", "energy", ",", "vec", ",", "uc", ",", "vc", 
                ",", "slope", ",", "boundaryPoint", ",", "edgeG", ",", 
                "edgeM", ",", "edgeK", ",", "kappaSquared", ",", 
                "edgeVectors", ",", "kappa", ",", RowBox[{"nuU", "=", 
                  RowBox[{"Abs", "[", RowBox[{"m", "+", "1"}], "]"}]}], ",", 
                RowBox[{"nuV", "=", RowBox[{"Abs", "[", RowBox[{"1", "-", 
                      "m"}], "]"}]}], ",", "basisDerivative", ",", 
                "derivative", ",", "coefficients", ",", "splitting", ",", 
                "rs", ",", "uValues", ",", "vValues", ",", "exact", ",", 
                "fitted", ",", "normExact", ",", "fitResidual", ",", 
                "derivativeResidual", ",", "imagMax"}], "}"}], ",", 
            RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"!", RowBox[{"TrueQ", 
                      "[", RowBox[{"0", "<", "fitFraction", "<", "1"}], 
                      "]"}]}], ",", RowBox[{"Return", "[", RowBox[{"Failure", 
                      "[", RowBox[{"\"InvalidEdgeWindow\"", ",", RowBox[
                         {"Association", "[", RowBox[{"\"FitFraction\"", 
                          "\[Rule]", "fitFraction"}], "]"}]}], "]"}], 
                    "]"}]}], "]"}], ";", RowBox[{"states", "=", 
                RowBox[{"modes", "[", RowBox[{"p", ",", "m", ",", "n", ",", 
                    "q"}], "]"}]}], ";", RowBox[{"If", "[", RowBox[
                 {RowBox[{RowBox[{"FailureQ", "[", "states", "]"}], "||", 
                    RowBox[{"!", RowBox[{"ListQ", "[", "states", "]"}]}], 
                    "||", RowBox[{RowBox[{"Length", "[", "states", "]"}], 
                      "\[Equal]", "0"}]}], ",", RowBox[{"Return", "[", 
                    RowBox[{"Failure", "[", RowBox[{"\"NoPhysicalDiscMode\"", 
                        ",", RowBox[{"Association", "[", RowBox[{RowBox[
                          {"\"m\"", "\[Rule]", "m"}], ",", RowBox[{"\"R\"", 
                          "\[Rule]", "radius"}], ",", RowBox[{"\"b\"", 
                          "\[Rule]", "bb"}], ",", RowBox[{"\"ModeResult\"", 
                          "\[Rule]", "states"}]}], "]"}]}], "]"}], "]"}]}], 
                "]"}], ";", RowBox[{"state", "=", RowBox[{"First", "[", 
                  RowBox[{"SortBy", "[", RowBox[{"states", ",", RowBox[
                       {RowBox[{"#1", "[", "\"Energy\"", "]"}], "&"}]}], 
                    "]"}], "]"}]}], ";", RowBox[{"energy", "=", 
                RowBox[{"state", "[", "\"Energy\"", "]"}]}], ";", 
              RowBox[{"vec", "=", RowBox[{"state", "[", "\"Vector\"", 
                  "]"}]}], ";", RowBox[{"If", "[", RowBox[
                 {RowBox[{RowBox[{"!", RowBox[{"VectorQ", "[", RowBox[
                         {"vec", ",", "NumericQ"}], "]"}]}], "||", 
                    RowBox[{RowBox[{"Length", "[", "vec", "]"}], 
                      "\[NotEqual]", RowBox[{"2", " ", "n"}]}], "||", 
                    RowBox[{"!", RowBox[{"NumericQ", "[", "energy", 
                        "]"}]}]}], ",", RowBox[{"Return", "[", RowBox[
                     {"Failure", "[", RowBox[{"\"InvalidDiscEigenpair\"", 
                        ",", RowBox[{"Association", "[", RowBox[{RowBox[
                          {"\"m\"", "\[Rule]", "m"}], ",", RowBox[
                          {"\"Energy\"", "\[Rule]", "energy"}], ",", RowBox[
                          {"\"VectorLength\"", "\[Rule]", RowBox[{"Length", 
                          "[", "vec", "]"}]}]}], "]"}]}], "]"}], "]"}]}], 
                "]"}], ";", RowBox[{"imagMax", "=", RowBox[{"Max", "[", 
                  RowBox[{"Abs", "[", RowBox[{"Im", "[", RowBox[{"N", "[", 
                        RowBox[{"Join", "[", RowBox[{RowBox[{"{", "energy", 
                          "}"}], ",", "vec"}], "]"}], "]"}], "]"}], "]"}], 
                  "]"}]}], ";", RowBox[{"If", "[", RowBox[
                 {RowBox[{"!", RowBox[{"TrueQ", "[", RowBox[{"imagMax", "<", 
                        FractionBox["1", SuperscriptBox["10", "8"]]}], 
                      "]"}]}], ",", RowBox[{"Return", "[", RowBox[{"Failure", 
                      "[", RowBox[{"\"ComplexDiscMode\"", ",", RowBox[
                         {"Association", "[", RowBox[{RowBox[{"\"m\"", 
                          "\[Rule]", "m"}], ",", RowBox[{"\"Energy\"", 
                          "\[Rule]", "energy"}], ",", RowBox[
                          {"\"ImaginaryPart\"", "\[Rule]", "imagMax"}]}], 
                          "]"}]}], "]"}], "]"}]}], "]"}], ";", 
              RowBox[{"energy", "=", RowBox[{"Re", "[", RowBox[{"N", "[", 
                    "energy", "]"}], "]"}]}], ";", RowBox[{"vec", "=", 
                RowBox[{"Re", "[", RowBox[{"N", "[", "vec", "]"}], "]"}]}], 
              ";", RowBox[{"If", "[", RowBox[{RowBox[{"energy", "<", 
                    RowBox[{"-", FractionBox["1", SuperscriptBox["10", 
                        "8"]]}]}], ",", RowBox[{"Return", "[", RowBox[
                     {"Failure", "[", RowBox[{"\"UnstableDiscMode\"", ",", 
                        RowBox[{"Association", "[", RowBox[{RowBox[{"\"m\"", 
                          "\[Rule]", "m"}], ",", RowBox[{"\"Energy\"", 
                          "\[Rule]", "energy"}], ",", RowBox[{"\"R\"", 
                          "\[Rule]", "radius"}], ",", RowBox[{"\"b\"", 
                          "\[Rule]", "bb"}]}], "]"}]}], "]"}], "]"}]}], 
                "]"}], ";", RowBox[{"uc", "=", RowBox[{"Take", "[", 
                  RowBox[{"vec", ",", "n"}], "]"}]}], ";", RowBox[{"vc", "=", 
                RowBox[{"Drop", "[", RowBox[{"vec", ",", "n"}], "]"}]}], ";", 
              RowBox[{"boundaryPoint", "=", RowBox[{"Last", "[", 
                  RowBox[{"First", "[", RowBox[{"beta", "[", "\"Domain\"", 
                      "]"}], "]"}], "]"}]}], ";", RowBox[{"slope", "=", 
                RowBox[{SuperscriptBox["beta", "\[Prime]", 
                   MultilineFunction -> None], "[", "boundaryPoint", "]"}]}], 
              ";", RowBox[{"edgeG", "=", RowBox[{RowBox[{"-", FractionBox[
                     SuperscriptBox["slope", "2"], "2"]}], "-", "slope"}]}], 
              ";", RowBox[{"edgeM", "=", RowBox[{"{", RowBox[
                   {RowBox[{"{", RowBox[{RowBox[{FractionBox[RowBox[
                          {SuperscriptBox[RowBox[{"(", RowBox[{"m", "-", 
                          "1"}], ")"}], "2"], "-", FractionBox["1", "4"]}], 
                          SuperscriptBox["radius", "2"]], "+", "edgeG", "+", 
                          "bb"}], ",", "edgeG"}], "}"}], ",", RowBox[
                     {"{", RowBox[{"edgeG", ",", RowBox[{FractionBox[RowBox[
                          {SuperscriptBox[RowBox[{"(", RowBox[{"m", "+", 
                          "1"}], ")"}], "2"], "-", FractionBox["1", "4"]}], 
                          SuperscriptBox["radius", "2"]], "+", "edgeG", "+", 
                          "bb"}]}], "}"}]}], "}"}]}], ";", RowBox[{"edgeK", 
                "=", RowBox[{"N", "[", RowBox[{"edgeM", "-", RowBox[
                     {"DiagonalMatrix", "[", RowBox[{"{", RowBox[{"energy", 
                          ",", RowBox[{"-", "energy"}]}], "}"}], "]"}]}], 
                  "]"}]}], ";", RowBox[{RowBox[{"{", RowBox[{"kappaSquared", 
                    ",", "edgeVectors"}], "}"}], "=", RowBox[{"Eigensystem", 
                  "[", "edgeK", "]"}]}], ";", RowBox[{"If", "[", 
                RowBox[{RowBox[{RowBox[{"!", RowBox[{"VectorQ", "[", 
                        RowBox[{"kappaSquared", ",", "NumericQ"}], "]"}]}], 
                    "||", RowBox[{"!", RowBox[{"TrueQ", "[", RowBox[
                         {RowBox[{"Max", "[", RowBox[{"Abs", "[", RowBox[
                          {"Im", "[", "kappaSquared", "]"}], "]"}], "]"}], 
                          "<", FractionBox["1", SuperscriptBox["10", "8"]]}], 
                        "]"}]}], "||", RowBox[{"!", RowBox[{"TrueQ", "[", 
                        RowBox[{RowBox[{"Min", "[", RowBox[{"Re", "[", 
                          "kappaSquared", "]"}], "]"}], ">", FractionBox["1", 
                          SuperscriptBox["10", "12"]]}], "]"}]}]}], ",", 
                  RowBox[{"Return", "[", RowBox[{"Failure", "[", RowBox[
                       {"\"NonEvanescentEdge\"", ",", RowBox[{"Association", 
                          "[", RowBox[{RowBox[{"\"m\"", "\[Rule]", "m"}], 
                          ",", RowBox[{"\"Energy\"", "\[Rule]", "energy"}], 
                          ",", RowBox[{"\"R\"", "\[Rule]", "radius"}], ",", 
                          RowBox[{"\"b\"", "\[Rule]", "bb"}], ",", RowBox[
                          {"\"KappaSquared\"", "\[Rule]", "kappaSquared"}], 
                          ",", RowBox[{"\"EdgeMatrix\"", "\[Rule]", 
                          "edgeK"}]}], "]"}]}], "]"}], "]"}]}], "]"}], ";", 
              RowBox[{"kappa", "=", SqrtBox[RowBox[{"Re", "[", 
                   "kappaSquared", "]"}]]}], ";", RowBox[{"edgeVectors", "=", 
                RowBox[{"Normalize", "/@", RowBox[{"Re", "[", "edgeVectors", 
                    "]"}]}]}], ";", RowBox[{RowBox[{"basisDerivative", "[", 
                  "nu_Integer", "]"}], ":=", RowBox[{"Module", "[", 
                  RowBox[{RowBox[{"{", RowBox[{"z", ",", "jp"}], "}"}], ",", 
                    RowBox[{RowBox[{"z", "=", RowBox[{"N", "[", RowBox[
                          {"zeros", "[", RowBox[{"nu", ",", "n"}], "]"}], 
                          "]"}]}], ";", RowBox[{"jp", "=", RowBox[
                         {RowBox[{"(", RowBox[{RowBox[{FractionBox["1", "2"], 
                          " ", RowBox[{"(", RowBox[{RowBox[{"BesselJ", "[", 
                          RowBox[{RowBox[{"nu", "-", "1"}], ",", "#1"}], 
                          "]"}], "-", RowBox[{"BesselJ", "[", RowBox[{RowBox[
                          {"nu", "+", "1"}], ",", "#1"}], "]"}]}], ")"}]}], 
                          "&"}], ")"}], "/@", "z"}]}], ";", FractionBox[
                       RowBox[{SqrtBox["2"], " ", "z", " ", "jp"}], RowBox[
                        {SuperscriptBox["radius", "2"], " ", RowBox[{"Abs", 
                          "[", "jp", "]"}]}]]}]}], "]"}]}], ";", 
              RowBox[{"derivative", "=", RowBox[{SqrtBox["radius"], " ", 
                  RowBox[{"{", RowBox[{RowBox[{"uc", ".", RowBox[
                         {"basisDerivative", "[", "nuU", "]"}]}], ",", 
                      RowBox[{"vc", ".", RowBox[{"basisDerivative", "[", 
                          "nuV", "]"}]}]}], "}"}]}]}], ";", 
              RowBox[{"coefficients", "=", FractionBox[RowBox[{"edgeVectors", 
                   ".", "derivative"}], "kappa"]}], ";", RowBox[{"splitting", 
                "=", RowBox[{"2", " ", RowBox[{"Total", "[", RowBox[
                     {SuperscriptBox[RowBox[{"Abs", "[", "coefficients", 
                         "]"}], "2"], " ", "kappa"}], "]"}]}]}], ";", 
              RowBox[{"rs", "=", RowBox[{"Subdivide", "[", RowBox[
                   {RowBox[{"radius", " ", RowBox[{"(", RowBox[{"1", "-", 
                          "fitFraction"}], ")"}]}], ",", "radius", ",", 
                    "24"}], "]"}]}], ";", RowBox[{"uValues", "=", 
                RowBox[{"uc", ".", RowBox[{"basis", "[", RowBox[{"nuU", ",", 
                      "n", ",", "radius", ",", "rs"}], "]"}]}]}], ";", 
              RowBox[{"vValues", "=", RowBox[{"vc", ".", RowBox[{"basis", 
                    "[", RowBox[{"nuV", ",", "n", ",", "radius", ",", "rs"}], 
                    "]"}]}]}], ";", RowBox[{"exact", "=", RowBox[
                 {"MapThread", "[", RowBox[{RowBox[{RowBox[{"#1", " ", 
                        "#2"}], "&"}], ",", RowBox[{"{", RowBox[{SqrtBox[
                         "rs"], ",", TemplateBox[{RowBox[{"{", RowBox[
                          {"uValues", ",", "vValues"}], "}"}]}, "Transpose", 
                         SyntaxForm -> SuperscriptBox]}], "}"}]}], "]"}]}], 
              ";", RowBox[{"fitted", "=", RowBox[{RowBox[{"Function", "[", 
                    RowBox[{"x", ",", RowBox[{"Total", "[", RowBox[
                         {"MapThread", "[", RowBox[{RowBox[{RowBox[{"#1", 
                          " ", RowBox[{"Sinh", "[", RowBox[{"#2", " ", RowBox[
                          {"(", RowBox[{"x", "-", "radius"}], ")"}]}], "]"}], 
                          " ", "#3"}], "&"}], ",", RowBox[{"{", RowBox[
                          {"coefficients", ",", "kappa", ",", 
                          "edgeVectors"}], "}"}]}], "]"}], "]"}]}], "]"}], 
                  "/@", "rs"}]}], ";", RowBox[{"normExact", "=", 
                TemplateBox[{RowBox[{"Flatten", "[", "exact", "]"}]}, 
                 "Norm"]}], ";", RowBox[{"fitResidual", "=", RowBox[
                 {"If", "[", RowBox[{RowBox[{"normExact", ">", "0"}], ",", 
                    FractionBox[TemplateBox[{RowBox[{"Flatten", "[", RowBox[
                          {"exact", "-", "fitted"}], "]"}]}, "Norm"], 
                     "normExact"], ",", "Indeterminate"}], "]"}]}], ";", 
              RowBox[{"derivativeResidual", "=", FractionBox[TemplateBox[
                  {RowBox[{"derivative", "-", RowBox[{"Total", "[", RowBox[
                        {"MapThread", "[", RowBox[{RowBox[{RowBox[{"#1", " ", 
                          "#2", " ", "#3"}], "&"}], ",", RowBox[{"{", RowBox[
                          {"coefficients", ",", "kappa", ",", 
                          "edgeVectors"}], "}"}]}], "]"}], "]"}]}]}, "Norm"], 
                 RowBox[{"Max", "[", RowBox[{TemplateBox[{"derivative"}, 
                      "Norm"], ",", "$MachineEpsilon"}], "]"}]]}], ";", 
              RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"!", RowBox[
                       {"NumericQ", "[", "splitting", "]"}]}], "||", 
                    RowBox[{"!", RowBox[{"NumericQ", "[", "fitResidual", 
                        "]"}]}], "||", RowBox[{"splitting", "<", "0"}]}], 
                  ",", RowBox[{"Return", "[", RowBox[{"Failure", "[", 
                      RowBox[{"\"InvalidEdgeMatch\"", ",", RowBox[
                         {"Association", "[", RowBox[{RowBox[{"\"m\"", 
                          "\[Rule]", "m"}], ",", RowBox[{"\"Splitting\"", 
                          "\[Rule]", "splitting"}], ",", RowBox[
                          {"\"FitRelativeError\"", "\[Rule]", 
                          "fitResidual"}]}], "]"}]}], "]"}], "]"}]}], "]"}], 
              ";", RowBox[{"Association", "[", RowBox[{RowBox[{"\"m\"", 
                    "\[Rule]", "m"}], ",", RowBox[{"\"b\"", "\[Rule]", 
                    "bb"}], ",", RowBox[{"\"R\"", "\[Rule]", "radius"}], ",", 
                  RowBox[{"\"DiscEnergy\"", "\[Rule]", "energy"}], ",", 
                  RowBox[{"\"Splitting\"", "\[Rule]", "splitting"}], ",", 
                  RowBox[{"\"BoundarySlope\"", "\[Rule]", "slope"}], ",", 
                  RowBox[{"\"EdgeMatrix\"", "\[Rule]", "edgeM"}], ",", 
                  RowBox[{"\"DecayMatrix\"", "\[Rule]", "edgeK"}], ",", 
                  RowBox[{"\"KappaSquared\"", "\[Rule]", "kappaSquared"}], 
                  ",", RowBox[{"\"Kappa\"", "\[Rule]", "kappa"}], ",", 
                  RowBox[{"\"EdgeEigenvectors\"", "\[Rule]", "edgeVectors"}], 
                  ",", RowBox[{"\"Coefficients\"", "\[Rule]", 
                    "coefficients"}], ",", RowBox[{"\"BoundaryDerivative\"", 
                    "\[Rule]", "derivative"}], ",", RowBox[
                   {"\"DerivativeRelativeError\"", "\[Rule]", 
                    "derivativeResidual"}], ",", RowBox[{"\"FitFraction\"", 
                    "\[Rule]", "fitFraction"}], ",", RowBox[
                   {"\"FitRelativeError\"", "\[Rule]", "fitResidual"}], ",", 
                  RowBox[{"\"FitRadii\"", "\[Rule]", "rs"}], ",", 
                  RowBox[{"\"ExactTransformedSpinor\"", "\[Rule]", "exact"}], 
                  ",", RowBox[{"\"FittedTransformedSpinor\"", "\[Rule]", 
                    "fitted"}]}], "]"}]}]}], "]"}]}], ";", 
      RowBox[{RowBox[{"bandSummary", "[", RowBox[{"p_Association", ",", 
            "m_Integer", ",", RowBox[{"n_Integer", ":", "40"}], ",", 
            RowBox[{"q_Integer", ":", "512"}]}], "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"edge", ",", 
                "energy", ",", "delta", ",", "onsite", ",", "hopping", ",", 
                "gammaEnergy", ",", "kEnergy"}], "}"}], ",", 
            RowBox[{RowBox[{"edge", "=", RowBox[{"edgeSplit", "[", 
                  RowBox[{"p", ",", "m", ",", "n", ",", "q"}], "]"}]}], ";", 
              RowBox[{"If", "[", RowBox[{RowBox[{"FailureQ", "[", "edge", 
                    "]"}], ",", RowBox[{"Return", "[", "edge", "]"}]}], 
                "]"}], ";", RowBox[{"energy", "=", RowBox[{"edge", "[", 
                  "\"DiscEnergy\"", "]"}]}], ";", RowBox[{"delta", "=", 
                RowBox[{"edge", "[", "\"Splitting\"", "]"}]}], ";", 
              RowBox[{"onsite", "=", RowBox[{"energy", "+", FractionBox[
                   "delta", "2"]}]}], ";", RowBox[{"hopping", "=", 
                RowBox[{FractionBox["1", "2"], " ", SuperscriptBox[
                   RowBox[{"(", RowBox[{"-", "1"}], ")"}], "m"], " ", 
                  "delta"}]}], ";", RowBox[{"gammaEnergy", "=", 
                RowBox[{"onsite", "+", RowBox[{"6", " ", "hopping"}]}]}], 
              ";", RowBox[{"kEnergy", "=", RowBox[{"onsite", "-", 
                  RowBox[{"3", " ", "hopping"}]}]}], ";", 
              RowBox[{"Association", "[", RowBox[{RowBox[{"\"m\"", "\[Rule]", 
                    "m"}], ",", RowBox[{"\"b\"", "\[Rule]", RowBox[{"p", "[", 
                      "\"b\"", "]"}]}], ",", RowBox[{"\"R\"", "\[Rule]", 
                    RowBox[{"p", "[", "\"R\"", "]"}]}], ",", RowBox[
                   {"\"Ell\"", "\[Rule]", RowBox[{"latticeSpacing", "[", 
                      RowBox[{"p", "[", "\"R\"", "]"}], "]"}]}], ",", 
                  RowBox[{"\"DiscEnergy\"", "\[Rule]", "energy"}], ",", 
                  RowBox[{"\"Splitting\"", "\[Rule]", "delta"}], ",", 
                  RowBox[{"\"Onsite\"", "\[Rule]", "onsite"}], ",", 
                  RowBox[{"\"Hopping\"", "\[Rule]", "hopping"}], ",", 
                  RowBox[{"\"GammaEnergy\"", "\[Rule]", "gammaEnergy"}], ",", 
                  RowBox[{"\"KEnergy\"", "\[Rule]", "kEnergy"}], ",", 
                  RowBox[{"\"Bottom\"", "\[Rule]", RowBox[{"Min", "[", 
                      RowBox[{"gammaEnergy", ",", "kEnergy"}], "]"}]}], ",", 
                  RowBox[{"\"Top\"", "\[Rule]", RowBox[{"Max", "[", 
                      RowBox[{"gammaEnergy", ",", "kEnergy"}], "]"}]}], ",", 
                  RowBox[{"\"Bandwidth\"", "\[Rule]", RowBox[{"9", " ", 
                      RowBox[{"Abs", "[", "hopping", "]"}]}]}], ",", 
                  RowBox[{"\"FitRelativeError\"", "\[Rule]", RowBox[
                     {"edge", "[", "\"FitRelativeError\"", "]"}]}], ",", 
                  RowBox[{"\"Edge\"", "\[Rule]", "edge"}]}], "]"}]}]}], 
          "]"}]}], ";", RowBox[{RowBox[{"bandEnergy", "[", 
          RowBox[{"band_Association", ",", RowBox[{"k", ":", RowBox[{"{", 
                RowBox[{RowBox[{"_", "?", "NumericQ"}], ",", RowBox[
                   {"_", "?", "NumericQ"}]}], "}"}]}]}], "]"}], ":=", 
        RowBox[{RowBox[{"band", "[", "\"Onsite\"", "]"}], "+", 
          RowBox[{"6", " ", RowBox[{"band", "[", "\"Hopping\"", "]"}], " ", 
            RowBox[{"gammaHex", "[", RowBox[{"k", ",", RowBox[{"band", "[", 
                  "\"Ell\"", "]"}]}], "]"}]}]}]}], ";", 
      RowBox[{RowBox[{"bandPath", "[", RowBox[{"band_Association", ",", 
            RowBox[{"pointsPerLeg_Integer", ":", "50"}]}], "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"ell", "=", RowBox[{"band", "[", 
                    "\"Ell\"", "]"}]}], ",", "vertices", ",", "coordinates", 
                ",", "distances", ",", "ticks"}], "}"}], ",", 
            RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{"pointsPerLeg", "<", 
                    "1"}], ",", RowBox[{"Return", "[", RowBox[{"Failure", 
                      "[", RowBox[{"\"InvalidPathSampling\"", ",", RowBox[
                         {"Association", "[", "]"}]}], "]"}], "]"}]}], "]"}], 
              ";", RowBox[{"vertices", "=", RowBox[{"N", "[", RowBox[
                   {"{", RowBox[{RowBox[{"{", RowBox[{"0", ",", "0"}], "}"}], 
                      ",", RowBox[{"{", RowBox[{FractionBox["\[Pi]", "ell"], 
                          ",", FractionBox["\[Pi]", RowBox[{SqrtBox["3"], 
                          " ", "ell"}]]}], "}"}], ",", RowBox[{"{", RowBox[
                         {FractionBox[RowBox[{"4", " ", "\[Pi]"}], RowBox[
                          {"3", " ", "ell"}]], ",", "0"}], "}"}], ",", 
                      RowBox[{"{", RowBox[{"0", ",", "0"}], "}"}]}], "}"}], 
                  "]"}]}], ";", RowBox[{"coordinates", "=", RowBox[
                 {"Join", "[", RowBox[{RowBox[{"Flatten", "[", RowBox[
                       {RowBox[{"Table", "[", RowBox[{RowBox[{"Most", "[", 
                          RowBox[{"Subdivide", "[", RowBox[{RowBox[
                          {"vertices", "\[LeftDoubleBracket]", "j", 
                          "\[RightDoubleBracket]"}], ",", RowBox[{"vertices", 
                          "\[LeftDoubleBracket]", RowBox[{"j", "+", "1"}], 
                          "\[RightDoubleBracket]"}], ",", "pointsPerLeg"}], 
                          "]"}], "]"}], ",", RowBox[{"{", RowBox[{"j", ",", 
                          "1", ",", "3"}], "}"}]}], "]"}], ",", "1"}], "]"}], 
                    ",", RowBox[{"{", RowBox[{"Last", "[", "vertices", "]"}], 
                      "}"}]}], "]"}]}], ";", RowBox[{"distances", "=", 
                RowBox[{"FoldList", "[", RowBox[{"Plus", ",", "0.`", ",", 
                    RowBox[{"Norm", "/@", RowBox[{"Differences", "[", 
                        "coordinates", "]"}]}]}], "]"}]}], ";", 
              RowBox[{"ticks", "=", TemplateBox[{RowBox[{"{", RowBox[
                     {RowBox[{"distances", "\[LeftDoubleBracket]", RowBox[
                         {"{", RowBox[{"1", ",", RowBox[{"pointsPerLeg", "+", 
                          "1"}], ",", RowBox[{RowBox[{"2", " ", 
                          "pointsPerLeg"}], "+", "1"}], ",", RowBox[
                          {RowBox[{"3", " ", "pointsPerLeg"}], "+", "1"}]}], 
                          "}"}], "\[RightDoubleBracket]"}], ",", RowBox[
                       {"{", RowBox[{"\"Gamma\"", ",", "\"M\"", ",", "\"K\"", 
                          ",", "\"Gamma\""}], "}"}]}], "}"}]}, "Transpose", 
                 SyntaxForm -> SuperscriptBox]}], ";", RowBox[{"Association", 
                "[", RowBox[{RowBox[{"\"Coordinates\"", "\[Rule]", 
                    "coordinates"}], ",", RowBox[{"\"Distance\"", "\[Rule]", 
                    "distances"}], ",", RowBox[{"\"Energy\"", "\[Rule]", 
                    RowBox[{RowBox[{"(", RowBox[{RowBox[{"bandEnergy", "[", 
                          RowBox[{"band", ",", "#1"}], "]"}], "&"}], ")"}], 
                      "/@", "coordinates"}]}], ",", RowBox[{"\"Ticks\"", 
                    "\[Rule]", "ticks"}]}], "]"}]}]}], "]"}]}], ";"}]], 
   "Input", CellLabel -> "In[21]:=", CellTags -> {"band-definitions"}], 
  Cell["Boundary-normalization audit: the text prints psi_tilde=sum c_i \
sinh[kappa_i(r-R)] and delta=2 sum c_i^2 kappa_i. We implement those formulas \
literally. The one-sided decaying exponential coefficient would be A_i=c_i/2; \
for a normalized scalar double well, the usual Wronskian comparison gives \
full splitting 4 sum kappa_i |A_i|^2, which is half the printed estimate. The \
corresponding hopping is one quarter of the printed estimate. These are \
different quantities, and inserting an arbitrary factor of four into the \
paper band formula is not justified. The literal calculation below does not \
reproduce the narrow envelope of Fig. 11. The shape residual tests local edge \
matching, not the full tunneling approximation or its onsite-energy \
convention.", "Text"], 
  Cell[CellGroupData[
    {Cell[BoxData[RowBox[{RowBox[{"referenceBands", "=", 
           RowBox[{"Table", "[", RowBox[{RowBox[{"bandSummary", "[", 
                 RowBox[{"referenceProfile", ",", "m", ",", "nRadial", ",", 
                   "nQuadrature"}], "]"}], ",", RowBox[{"{", RowBox[
                  {"m", ",", RowBox[{"{", RowBox[{RowBox[{"-", "1"}], ",", 
                       RowBox[{"-", "2"}]}], "}"}]}], "}"}]}], "]"}]}], ";", 
         RowBox[{"If", "[", RowBox[{RowBox[{"AnyTrue", "[", RowBox[
                {"referenceBands", ",", "FailureQ"}], "]"}], ",", 
             RowBox[{RowBox[{"Print", "[", "referenceBands", "]"}], ";", 
               RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
         RowBox[{"Grid", "[", RowBox[{RowBox[{"Prepend", "[", RowBox[
                {RowBox[{"Table", "[", RowBox[{RowBox[{"{", RowBox[
                        {RowBox[{"band", "[", "\"m\"", "]"}], ",", RowBox[
                          {"band", "[", "\"DiscEnergy\"", "]"}], ",", 
                         RowBox[{"band", "[", "\"Splitting\"", "]"}], ",", 
                         RowBox[{"band", "[", "\"Bottom\"", "]"}], ",", 
                         RowBox[{"band", "[", "\"Top\"", "]"}], ",", RowBox[
                          {"band", "[", "\"FitRelativeError\"", "]"}], ",", 
                         FractionBox[RowBox[{"band", "[", "\"Splitting\"", 
                          "]"}], "2"], ",", FractionBox[RowBox[{"band", "[", 
                          "\"Splitting\"", "]"}], "4"]}], "}"}], ",", 
                     RowBox[{"{", RowBox[{"band", ",", "referenceBands"}], 
                       "}"}]}], "]"}], ",", RowBox[{"{", RowBox[{"\"m\"", 
                     ",", "\"Disk energy\"", ",", "\"Printed delta\"", ",", 
                     "\"Band bottom\"", ",", "\"Band top\"", ",", 
                     "\"Edge shape relative residual\"", ",", 
                     "\"Scalar Wronskian full splitting (comparison)\"", ",", 
                     "\"Scalar hopping magnitude (comparison)\""}], "}"}]}], 
               "]"}], ",", RowBox[{"Frame", "\[Rule]", "All"}], ",", 
