           RowBox[{"N", "[", RowBox[{"Range", "[", RowBox[{FractionBox["24", 
                  "5"], ",", "7", ",", FractionBox["2", "5"]}], "]"}], 
             "]"}]}], ";", RowBox[{"thresholdRows", "=", 
           RowBox[{"Flatten", "[", RowBox[{RowBox[{"Table", "[", 
                 RowBox[{RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[
                          {"data", ",", "pairs", ",", "cross"}], "}"}], ",", 
                       RowBox[{RowBox[{"data", "=", RowBox[{"Table", "[", 
                          RowBox[{RowBox[{"{", RowBox[{"rr", ",", RowBox[
                          {RowBox[{"First", "[", RowBox[{"modes", "[", RowBox[
                          {RowBox[{"profile", "[", RowBox[{"bb", ",", "rr"}], 
                          "]"}], ",", "m", ",", "nRadial", ",", 
                          "nQuadrature"}], "]"}], "]"}], "[", "\"Energy\"", 
                          "]"}]}], "}"}], ",", RowBox[{"{", RowBox[{"rr", 
                          ",", "thresholdRadii"}], "}"}]}], "]"}]}], ";", 
                         RowBox[{"pairs", "=", RowBox[{"Select", "[", RowBox[
                          {RowBox[{"Partition", "[", RowBox[{"data", ",", 
                          "2", ",", "1"}], "]"}], ",", RowBox[{RowBox[
                          {RowBox[{"Times", "@@", RowBox[{"#1", 
                          "\[LeftDoubleBracket]", RowBox[{"All", ",", "2"}], 
                          "\[RightDoubleBracket]"}]}], "\[LessEqual]", "0"}], 
                          "&"}]}], "]"}]}], ";", RowBox[{"cross", "=", 
                          RowBox[{"If", "[", RowBox[{RowBox[{"pairs", 
                          "\[Equal]", RowBox[{"{", "}"}]}], ",", RowBox[
                          {"Missing", "[", "\"OutsideScan\"", "]"}], ",", 
                          RowBox[{"With", "[", RowBox[{RowBox[{"{", RowBox[
                          {"pp", "=", RowBox[{"First", "[", "pairs", "]"}]}], 
